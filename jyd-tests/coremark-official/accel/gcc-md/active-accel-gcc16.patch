diff --git a/gcc/tree-clipped-rising-score.cc b/gcc/tree-clipped-rising-score.cc
new file mode 100644
index 00000000000..c70b67e0d62
--- /dev/null
+++ b/gcc/tree-clipped-rising-score.cc
@@ -0,0 +1,2202 @@
+/* Recognize accelerator idioms (clipped rising-score reduction, in-place
+   list reversal, numeric-token DFA scan) and expose them to the target.  */
+
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "backend.h"
+#include "tree.h"
+#include "gimple.h"
+#include "gimple-iterator.h"
+#include "tree-pass.h"
+#include "ssa.h"
+#include "tree-dfa.h"
+#include "tree-cfg.h"
+#include "tree-into-ssa.h"
+#include "fold-const.h"
+#include "cfghooks.h"
+#include "cfgloop.h"
+#include "tree-ssa-loop.h"
+#include "cgraph.h"
+#include "internal-fn.h"
+#include "diagnostic-core.h"
+#include "hash-set.h"
+
+namespace {
+
+/* Callee bodies are not stable once their per-function passes have completed.
+   Record transition declarations while their own GIMPLE CFG is current, then
+   consume only those declarations when recognizing the enclosing scan.  */
+static hash_set<tree> xdfascan_transition_decls;
+
+/* Follow the small scalar expression graphs produced for this reduction.  */
+static bool
+depends_on (tree value, tree root, unsigned depth = 0)
+{
+  if (value == root)
+    return true;
+  if (TREE_CODE (value) == SSA_NAME && SSA_NAME_VAR (value) == root)
+    return true;
+  if (depth == 10 || TREE_CODE (value) != SSA_NAME)
+    return false;
+  gimple *def = SSA_NAME_DEF_STMT (value);
+  if (!def || gimple_nop_p (def))
+    return false;
+  if (is_gimple_assign (def))
+    {
+      for (unsigned i = 1; i < gimple_num_ops (def); ++i)
+	if (gimple_op (def, i)
+	    && depends_on (gimple_op (def, i), root, depth + 1))
+	  return true;
+    }
+  else if (gimple_code (def) == GIMPLE_PHI)
+    for (unsigned i = 0; i < gimple_phi_num_args (def); ++i)
+      if (depends_on (gimple_phi_arg_def (def, i), root, depth + 1))
+	return true;
+  return false;
+}
+
+static bool
+zero_cst_p (tree x)
+{
+  return x && TREE_CODE (x) == INTEGER_CST && integer_zerop (x);
+}
+
+static bool
+phi_has (tree phi_name, tree value, bool want_zero)
+{
+  if (TREE_CODE (phi_name) != SSA_NAME)
+    return false;
+  gimple *def = SSA_NAME_DEF_STMT (phi_name);
+  if (!def || gimple_code (def) != GIMPLE_PHI)
+    return false;
+  bool found_value = false, found_zero = false;
+  for (unsigned i = 0; i < gimple_phi_num_args (def); ++i)
+    {
+      tree arg = gimple_phi_arg_def (def, i);
+      found_value |= arg == value;
+      found_zero |= zero_cst_p (arg);
+    }
+  return found_value && (!want_zero || found_zero);
+}
+
+static bool
+clipped_rising_score_p (tree n, tree base, tree clip)
+{
+  tree cur = NULL_TREE, sum = NULL_TREE, reset_phi = NULL_TREE;
+  tree rise = NULL_TREE, ten_add = NULL_TREE;
+  unsigned n_loop_tests = 0;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      {
+	gimple *s = gsi_stmt (gsi);
+	if (is_gimple_assign (s))
+	  {
+	    tree lhs = gimple_assign_lhs (s);
+	    enum tree_code code = gimple_assign_rhs_code (s);
+	    if (code == MEM_REF
+		&& depends_on (TREE_OPERAND (gimple_assign_rhs1 (s), 0), base))
+	      {
+		if (cur)
+		  return false;
+		cur = lhs;
+	      }
+	    if (code == PLUS_EXPR && cur
+		&& (gimple_assign_rhs1 (s) == cur
+		    || gimple_assign_rhs2 (s) == cur))
+	      {
+		tree other = (gimple_assign_rhs1 (s) == cur
+			      ? gimple_assign_rhs2 (s) : gimple_assign_rhs1 (s));
+		if (TREE_CODE (other) == SSA_NAME
+		    && gimple_code (SSA_NAME_DEF_STMT (other)) == GIMPLE_PHI)
+		  sum = lhs, reset_phi = other;
+	      }
+	    if (code == PLUS_EXPR)
+	      {
+		tree a = gimple_assign_rhs1 (s), b = gimple_assign_rhs2 (s);
+		if ((TREE_CODE (a) == INTEGER_CST && wi::to_wide (a) == 10)
+		    || (TREE_CODE (b) == INTEGER_CST && wi::to_wide (b) == 10))
+		  ten_add = lhs;
+	      }
+	    if (code == LT_EXPR && cur && gimple_assign_rhs2 (s) == cur
+		&& TREE_CODE (gimple_assign_rhs1 (s)) == SSA_NAME
+		&& gimple_code (SSA_NAME_DEF_STMT (gimple_assign_rhs1 (s)))
+		   == GIMPLE_PHI)
+	      rise = lhs;
+	  }
+	else if (gimple_code (s) == GIMPLE_COND)
+	  {
+	    tree a = gimple_cond_lhs (s), b = gimple_cond_rhs (s);
+	    enum tree_code code = gimple_cond_code (s);
+	    if (((code == GT_EXPR && a == sum && depends_on (b, clip))
+		 || (code == LT_EXPR && b == sum && depends_on (a, clip))))
+	      ;
+	    else if (code == GT_EXPR && cur
+		     && (a == cur || b == cur))
+	      rise = cur;
+	    else if ((code == GT_EXPR || code == LT_EXPR || code == NE_EXPR)
+		     && (depends_on (a, n) || depends_on (b, n)))
+	      ++n_loop_tests;
+	  }
+      }
+
+  if (sum)
+    FOR_EACH_BB_FN (bb, cfun)
+      for (gphi_iterator psi = gsi_start_phis (bb);
+	   !gsi_end_p (psi); gsi_next (&psi))
+	{
+	  tree lhs = gimple_phi_result (*psi);
+	  if (phi_has (lhs, sum, true))
+	    reset_phi = lhs;
+	}
+
+  if (!cur || !sum || !reset_phi || !rise || !ten_add || n_loop_tests < 2)
+    return false;
+  if (!phi_has (reset_phi, sum, true))
+    return false;
+
+  /* Require the threshold and rising comparisons explicitly.  */
+  bool threshold = false, rising = rise != NULL_TREE;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      if (gimple_code (gsi_stmt (gsi)) == GIMPLE_COND)
+	{
+	  gcond *c = as_a<gcond *> (gsi_stmt (gsi));
+	  tree a = gimple_cond_lhs (c), b = gimple_cond_rhs (c);
+	  threshold |= ((gimple_cond_code (c) == GT_EXPR && a == sum
+			 && depends_on (b, clip))
+			|| (gimple_cond_code (c) == LT_EXPR && b == sum
+			    && depends_on (a, clip)));
+	}
+  return threshold && rising;
+}
+
+static tree ref_root_ssa (tree);
+
+/* Match a read-only linked-list lookup with two comparison modes.  The
+   recognizer deliberately uses only types, data-flow and memory behavior: a
+   symbol rename must neither enable nor disable the instruction.  */
+static bool
+list_find_p ()
+{
+  tree list = DECL_ARGUMENTS (cfun->decl);
+  tree info = list ? DECL_CHAIN (list) : NULL_TREE;
+  tree ret_type = TREE_TYPE (TREE_TYPE (cfun->decl));
+  if (!list || !info || DECL_CHAIN (info) || !POINTER_TYPE_P (ret_type)
+      || !POINTER_TYPE_P (TREE_TYPE (list))
+      || !POINTER_TYPE_P (TREE_TYPE (info))
+      || !types_compatible_p (ret_type, TREE_TYPE (list)))
+    return false;
+
+  tree list_ssa = ssa_default_def (cfun, list);
+  tree info_ssa = ssa_default_def (cfun, info);
+  unsigned list_reads = 0, info_reads = 0, conditions = 0, returns = 0;
+  unsigned pointer_steps = 0;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      {
+	gimple *stmt = gsi_stmt (gsi);
+	if (is_gimple_debug (stmt))
+	  continue;
+	if (gimple_code (stmt) == GIMPLE_CALL || gimple_store_p (stmt))
+	  return false;
+	if (gimple_code (stmt) == GIMPLE_COND)
+	  {
+	    ++conditions;
+	    continue;
+	  }
+	if (gimple_code (stmt) == GIMPLE_RETURN)
+	  {
+	    ++returns;
+	    tree value = gimple_return_retval (as_a<greturn *> (stmt));
+	    if (value && !zero_cst_p (value)
+		&& !depends_on (value, list_ssa))
+	      return false;
+	    continue;
+	  }
+	if (!is_gimple_assign (stmt))
+	  {
+	    switch (gimple_code (stmt))
+	      {
+	      case GIMPLE_GOTO:
+	      case GIMPLE_LABEL:
+	      case GIMPLE_NOP:
+	      case GIMPLE_PREDICT:
+		continue;
+	      default:
+		return false;
+	      }
+	  }
+	enum tree_code code = gimple_assign_rhs_code (stmt);
+	if (code != MEM_REF && code != COMPONENT_REF)
+	  continue;
+	tree root = ref_root_ssa (gimple_assign_rhs1 (stmt));
+	if (root && depends_on (root, list_ssa))
+	  {
+	    ++list_reads;
+	    if (POINTER_TYPE_P (TREE_TYPE (gimple_assign_lhs (stmt))))
+	      ++pointer_steps;
+	  }
+	else if (root && depends_on (root, info_ssa))
+	  ++info_reads;
+      }
+  return list_reads >= 4 && info_reads >= 2 && pointer_steps >= 2
+    && conditions >= 4 && returns == 1;
+}
+
+/* Match the canonical square matrix accumulation.  The bit-field form is
+   identified by its two masks and shifts rather than source-level symbols.  */
+static bool
+matrix_accumulate_p (bool *bit_extract)
+{
+  tree n = DECL_ARGUMENTS (cfun->decl);
+  tree c = n ? DECL_CHAIN (n) : NULL_TREE;
+  tree a = c ? DECL_CHAIN (c) : NULL_TREE;
+  tree b = a ? DECL_CHAIN (a) : NULL_TREE;
+  if (!n || !c || !a || !b || DECL_CHAIN (b)
+      || TREE_TYPE (TREE_TYPE (cfun->decl)) != void_type_node
+      || TYPE_PRECISION (TREE_TYPE (n)) != 32
+      || !POINTER_TYPE_P (TREE_TYPE (c))
+      || !POINTER_TYPE_P (TREE_TYPE (a))
+      || !POINTER_TYPE_P (TREE_TYPE (b))
+      || TYPE_PRECISION (TREE_TYPE (TREE_TYPE (c))) != 32
+      || TYPE_PRECISION (TREE_TYPE (TREE_TYPE (a))) != 16
+      || TYPE_PRECISION (TREE_TYPE (TREE_TYPE (b))) != 16)
+    return false;
+
+  tree n_ssa = ssa_default_def (cfun, n);
+  tree c_ssa = ssa_default_def (cfun, c);
+  tree a_ssa = ssa_default_def (cfun, a);
+  tree b_ssa = ssa_default_def (cfun, b);
+  unsigned reads_a = 0, reads_b = 0, writes_c = 0;
+  unsigned multiplies = 0, accumulates = 0, bounds = 0;
+  bool shift2 = false, shift5 = false, mask15 = false, mask127 = false;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      {
+	gimple *stmt = gsi_stmt (gsi);
+	if (is_gimple_debug (stmt))
+	  continue;
+	if (gimple_code (stmt) == GIMPLE_CALL)
+	  return false;
+	if (gimple_code (stmt) == GIMPLE_COND)
+	  {
+	    gcond *cond = as_a<gcond *> (stmt);
+	    if (depends_on (gimple_cond_lhs (cond), n_ssa)
+		|| depends_on (gimple_cond_rhs (cond), n_ssa))
+	      ++bounds;
+	    continue;
+	  }
+	if (!is_gimple_assign (stmt))
+	  continue;
+	if (gimple_store_p (stmt))
+	  {
+	    tree root = ref_root_ssa (gimple_assign_lhs (stmt));
+	    if (!root || !depends_on (root, c_ssa))
+	      return false;
+	    ++writes_c;
+	  }
+	enum tree_code code = gimple_assign_rhs_code (stmt);
+	if (code == MEM_REF || code == COMPONENT_REF)
+	  {
+	    tree root = ref_root_ssa (gimple_assign_rhs1 (stmt));
+	    if (root && depends_on (root, a_ssa))
+	      ++reads_a;
+	    if (root && depends_on (root, b_ssa))
+	      ++reads_b;
+	  }
+	else if (code == MULT_EXPR)
+	  ++multiplies;
+	else if (code == PLUS_EXPR)
+	  ++accumulates;
+	else if (code == RSHIFT_EXPR
+		 && TREE_CODE (gimple_assign_rhs2 (stmt)) == INTEGER_CST)
+	  {
+	    shift2 |= wi::to_wide (gimple_assign_rhs2 (stmt)) == 2;
+	    shift5 |= wi::to_wide (gimple_assign_rhs2 (stmt)) == 5;
+	  }
+	else if (code == BIT_AND_EXPR)
+	  {
+	    tree x = gimple_assign_rhs1 (stmt), y = gimple_assign_rhs2 (stmt);
+	    tree k = TREE_CODE (x) == INTEGER_CST ? x
+	      : TREE_CODE (y) == INTEGER_CST ? y : NULL_TREE;
+	    if (k)
+	      {
+		mask15 |= wi::to_wide (k) == 15;
+		mask127 |= wi::to_wide (k) == 127;
+	      }
+	  }
+      }
+
+  *bit_extract = shift2 && shift5 && mask15 && mask127;
+  return reads_a >= 1 && reads_b >= 1 && writes_c >= 2
+    && multiplies >= 4 && accumulates >= 3 && bounds >= 3;
+}
+
+static bool
+conversion_chain_from_p (tree value, tree root, unsigned depth = 0)
+{
+  if (!value || !root
+      || !INTEGRAL_TYPE_P (TREE_TYPE (value))
+      || TYPE_PRECISION (TREE_TYPE (value)) < 16
+      || !INTEGRAL_TYPE_P (TREE_TYPE (root))
+      || TYPE_PRECISION (TREE_TYPE (root)) < 16)
+    return false;
+  if (value == root)
+    return true;
+  if (depth == 4 || TREE_CODE (value) != SSA_NAME)
+    return false;
+  gimple *def = SSA_NAME_DEF_STMT (value);
+  if (!def || !is_gimple_assign (def))
+    return false;
+  enum tree_code code = gimple_assign_rhs_code (def);
+  if (code != NOP_EXPR && code != CONVERT_EXPR)
+    return false;
+  tree source = gimple_assign_rhs1 (def);
+  if (!INTEGRAL_TYPE_P (TREE_TYPE (source))
+      || TYPE_PRECISION (TREE_TYPE (source)) < 16)
+    return false;
+  return conversion_chain_from_p (source, root, depth + 1);
+}
+
+static bool
+unit_step_counter_p (tree counter, class loop **counter_loop)
+{
+  if (TREE_CODE (counter) != SSA_NAME)
+    return false;
+  gimple *phi_stmt = SSA_NAME_DEF_STMT (counter);
+  if (!phi_stmt || gimple_code (phi_stmt) != GIMPLE_PHI
+      || gimple_phi_num_args (phi_stmt) != 2)
+    return false;
+  gphi *phi = as_a<gphi *> (phi_stmt);
+  basic_block header = gimple_bb (phi_stmt);
+  class loop *loop = header->loop_father;
+  if (!loop || loop == loops_for_fn (cfun)->tree_root || loop->header != header)
+    return false;
+  tree update = NULL_TREE;
+  bool has_zero = false;
+  for (unsigned i = 0; i < 2; ++i)
+    {
+      tree arg = gimple_phi_arg_def (phi, i);
+      if (zero_cst_p (arg))
+	{
+	  if (flow_bb_inside_loop_p (loop, gimple_phi_arg_edge (phi, i)->src))
+	    return false;
+	  has_zero = true;
+	}
+      else
+	{
+	  if (!flow_bb_inside_loop_p (loop,
+				      gimple_phi_arg_edge (phi, i)->src))
+	    return false;
+	  update = arg;
+	}
+    }
+  if (!has_zero || !update || TREE_CODE (update) != SSA_NAME)
+    return false;
+  gimple *update_stmt = SSA_NAME_DEF_STMT (update);
+  if (!update_stmt || !is_gimple_assign (update_stmt)
+      || gimple_assign_rhs_code (update_stmt) != PLUS_EXPR
+      || !flow_bb_inside_loop_p (loop, gimple_bb (update_stmt)))
+    return false;
+  tree lhs = gimple_assign_rhs1 (update_stmt);
+  tree rhs = gimple_assign_rhs2 (update_stmt);
+  tree one = TREE_CODE (lhs) == INTEGER_CST ? lhs
+    : TREE_CODE (rhs) == INTEGER_CST ? rhs : NULL_TREE;
+  tree source = lhs == one ? rhs : lhs;
+  if (source != counter || !one || !integer_onep (one))
+    return false;
+  *counter_loop = loop;
+  return true;
+}
+
+static bool
+matrix_element_address_p (tree reference, tree base, tree n,
+			  tree first_counter, tree second_counter)
+{
+  if (TREE_CODE (reference) != MEM_REF
+      || !INTEGRAL_TYPE_P (TREE_TYPE (reference))
+      || TYPE_PRECISION (TREE_TYPE (reference)) != 16
+      || TYPE_ALIGN (TREE_TYPE (reference)) < 16)
+    return false;
+  if (TREE_THIS_VOLATILE (reference)
+      || !zero_cst_p (TREE_OPERAND (reference, 1)))
+    return false;
+  tree address = TREE_OPERAND (reference, 0);
+  if (TREE_CODE (address) != SSA_NAME)
+    return false;
+  gimple *pointer = SSA_NAME_DEF_STMT (address);
+  if (!pointer || !is_gimple_assign (pointer)
+      || gimple_assign_rhs_code (pointer) != POINTER_PLUS_EXPR
+      || gimple_assign_rhs1 (pointer) != base)
+    return false;
+  tree scaled = gimple_assign_rhs2 (pointer);
+  if (TREE_CODE (scaled) != SSA_NAME)
+    return false;
+  gimple *scale = SSA_NAME_DEF_STMT (scaled);
+  if (!scale || !is_gimple_assign (scale)
+      || gimple_assign_rhs_code (scale) != MULT_EXPR)
+    return false;
+  tree scale_lhs = gimple_assign_rhs1 (scale);
+  tree scale_rhs = gimple_assign_rhs2 (scale);
+  tree two = TREE_CODE (scale_lhs) == INTEGER_CST ? scale_lhs
+    : TREE_CODE (scale_rhs) == INTEGER_CST ? scale_rhs : NULL_TREE;
+  tree index = scale_lhs == two ? scale_rhs : scale_lhs;
+  if (!two || wi::to_wide (two) != 2 || TREE_CODE (index) != SSA_NAME)
+    return false;
+  gimple *sum = SSA_NAME_DEF_STMT (index);
+  if (!sum || !is_gimple_assign (sum)
+      || gimple_assign_rhs_code (sum) != PLUS_EXPR)
+    return false;
+  tree sum_lhs = gimple_assign_rhs1 (sum);
+  tree sum_rhs = gimple_assign_rhs2 (sum);
+  tree product = sum_lhs == first_counter || sum_lhs == second_counter
+    ? sum_rhs : sum_lhs;
+  tree inner = product == sum_lhs ? sum_rhs : sum_lhs;
+  if (inner != first_counter && inner != second_counter)
+    return false;
+  tree outer = inner == first_counter ? second_counter : first_counter;
+  if (TREE_CODE (product) != SSA_NAME)
+    return false;
+  gimple *multiply = SSA_NAME_DEF_STMT (product);
+  if (!multiply || !is_gimple_assign (multiply)
+      || gimple_assign_rhs_code (multiply) != MULT_EXPR)
+    return false;
+  tree mul_lhs = gimple_assign_rhs1 (multiply);
+  tree mul_rhs = gimple_assign_rhs2 (multiply);
+  return ((mul_lhs == outer && mul_rhs == n)
+	  || (mul_rhs == outer && mul_lhs == n));
+}
+
+/* Match exactly an in-place square int16 matrix scalar-add loop.  Selection
+   depends on types, induction variables, address arithmetic and value flow;
+   function and local-variable names are irrelevant.  */
+static bool
+packed_halfword_square_add_p ()
+{
+  tree n = DECL_ARGUMENTS (cfun->decl);
+  tree base = n ? DECL_CHAIN (n) : NULL_TREE;
+  tree addend = base ? DECL_CHAIN (base) : NULL_TREE;
+  if (!n || !base || !addend || DECL_CHAIN (addend)
+      || TREE_TYPE (TREE_TYPE (cfun->decl)) != void_type_node
+      || !INTEGRAL_TYPE_P (TREE_TYPE (n))
+      || TYPE_PRECISION (TREE_TYPE (n)) != 32
+      || !TYPE_UNSIGNED (TREE_TYPE (n))
+      || !POINTER_TYPE_P (TREE_TYPE (base))
+      || !INTEGRAL_TYPE_P (TREE_TYPE (TREE_TYPE (base)))
+      || TYPE_PRECISION (TREE_TYPE (TREE_TYPE (base))) != 16
+      || TYPE_ALIGN (TREE_TYPE (TREE_TYPE (base))) < 16
+      || !INTEGRAL_TYPE_P (TREE_TYPE (addend))
+      || TYPE_PRECISION (TREE_TYPE (addend)) != 16)
+    return false;
+
+  tree n_ssa = ssa_default_def (cfun, n);
+  tree base_ssa = ssa_default_def (cfun, base);
+  tree addend_ssa = ssa_default_def (cfun, addend);
+  tree counters[2] = { NULL_TREE, NULL_TREE };
+  class loop *counter_loops[2] = { NULL, NULL };
+  tree load_value = NULL_TREE, data_sum = NULL_TREE;
+  tree load_ref = NULL_TREE, store_ref = NULL_TREE, store_value = NULL_TREE;
+  unsigned conditions = 0, returns = 0, loads = 0, stores = 0;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      {
+	gimple *stmt = gsi_stmt (gsi);
+	if (is_gimple_debug (stmt))
+	  continue;
+	if (gimple_code (stmt) == GIMPLE_CALL)
+	  return false;
+	if (gimple_code (stmt) == GIMPLE_RETURN)
+	  {
+	    if (gimple_return_retval (as_a<greturn *> (stmt)))
+	      return false;
+	    ++returns;
+	    continue;
+	  }
+	if (gimple_code (stmt) == GIMPLE_COND)
+	  {
+	    gcond *cond = as_a<gcond *> (stmt);
+	    if (gimple_cond_code (cond) != LT_EXPR
+		|| gimple_cond_rhs (cond) != n_ssa || conditions == 2)
+	      return false;
+	    tree counter = gimple_cond_lhs (cond);
+	    if (!unit_step_counter_p (counter, &counter_loops[conditions]))
+	      return false;
+	    class loop *counter_loop = counter_loops[conditions];
+	    auto_vec<edge> loop_exits = get_loop_exit_edges (counter_loop);
+	    edge loop_exit = loop_exits.length () == 1 ? loop_exits[0] : NULL;
+	    if (gimple_bb (cond) != counter_loop->header || !loop_exit
+		|| loop_exit->src != gimple_bb (cond)
+		|| !(loop_exit->flags & EDGE_FALSE_VALUE))
+	      return false;
+	    counters[conditions++] = counter;
+	    continue;
+	  }
+	if (!is_gimple_assign (stmt))
+	  {
+	    enum gimple_code code = gimple_code (stmt);
+	    if (code == GIMPLE_LABEL || code == GIMPLE_NOP
+		|| code == GIMPLE_PREDICT)
+	      continue;
+	    return false;
+	  }
+	if (gimple_has_volatile_ops (stmt))
+	  return false;
+	if (gimple_store_p (stmt))
+	  {
+	    ++stores;
+	    store_ref = gimple_assign_lhs (stmt);
+	    store_value = gimple_assign_rhs1 (stmt);
+	    continue;
+	  }
+	enum tree_code code = gimple_assign_rhs_code (stmt);
+	if (code == MEM_REF)
+	  {
+	    ++loads;
+	    load_ref = gimple_assign_rhs1 (stmt);
+	    load_value = gimple_assign_lhs (stmt);
+	  }
+	else if (code == PLUS_EXPR)
+	  {
+	    tree result = gimple_assign_lhs (stmt);
+	    tree lhs = gimple_assign_rhs1 (stmt);
+	    tree rhs = gimple_assign_rhs2 (stmt);
+	    if (load_value
+		&& ((conversion_chain_from_p (lhs, load_value)
+		     && conversion_chain_from_p (rhs, addend_ssa))
+		    || (conversion_chain_from_p (rhs, load_value)
+			&& conversion_chain_from_p (lhs, addend_ssa))))
+	      {
+		if (data_sum)
+		  return false;
+		data_sum = result;
+	      }
+	  }
+      }
+
+  class loop *root_loop = loops_for_fn (cfun)->tree_root;
+  bool directly_nested
+    = ((counter_loops[0] && counter_loops[1]
+	&& loop_outer (counter_loops[0]) == counter_loops[1]
+	&& loop_outer (counter_loops[1]) == root_loop)
+       || (counter_loops[0] && counter_loops[1]
+	   && loop_outer (counter_loops[1]) == counter_loops[0]
+	   && loop_outer (counter_loops[0]) == root_loop));
+  return number_of_loops (cfun) == 3
+    && conditions == 2 && counters[0] != counters[1]
+	&& counter_loops[0] != counter_loops[1]
+	&& directly_nested
+    && returns == 1 && loads == 1 && stores == 1 && load_value && data_sum
+    && load_ref && store_ref && operand_equal_p (load_ref, store_ref, 0)
+    && store_value && conversion_chain_from_p (store_value, data_sum)
+    && matrix_element_address_p (load_ref, base_ssa, n_ssa,
+				 counters[0], counters[1]);
+}
+
+static void
+lower_clipped_rising_score (tree n, tree base, tree clip)
+{
+  tree u32 = unsigned_type_node;
+  basic_block bb = create_empty_bb (ENTRY_BLOCK_PTR_FOR_FN (cfun));
+  if (loops_for_fn (cfun))
+    add_bb_to_loop (bb, loops_for_fn (cfun)->tree_root);
+  edge entry_edge = single_succ_edge (ENTRY_BLOCK_PTR_FOR_FN (cfun));
+  redirect_edge_succ (entry_edge, bb);
+  make_edge (bb, EXIT_BLOCK_PTR_FOR_FN (cfun), 0);
+  gimple_stmt_iterator gsi = gsi_start_bb (bb);
+
+  tree clip16 = make_ssa_name (short_unsigned_type_node);
+  gsi_insert_before (&gsi, gimple_build_assign (clip16, NOP_EXPR, clip),
+		     GSI_SAME_STMT);
+  tree clip32 = make_ssa_name (u32);
+  gsi_insert_before (&gsi, gimple_build_assign (clip32, NOP_EXPR, clip16),
+		     GSI_SAME_STMT);
+  tree raw = make_ssa_name (u32);
+  gcall *call = gimple_build_call_internal
+    (IFN_CLIPPED_RISING_SCORE_REDUCE, 3, base, n, clip32);
+  gimple_call_set_lhs (call, raw);
+  gsi_insert_before (&gsi, call, GSI_SAME_STMT);
+  tree result = make_ssa_name (TREE_TYPE (TREE_TYPE (cfun->decl)));
+  gsi_insert_before (&gsi, gimple_build_assign (result, NOP_EXPR, raw),
+		     GSI_SAME_STMT);
+  gsi_insert_before (&gsi, gimple_build_return (result), GSI_SAME_STMT);
+}
