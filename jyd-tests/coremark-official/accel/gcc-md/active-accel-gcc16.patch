+(define_expand "xlistfindsi3"
+  [(set (match_operand:SI 0 "register_operand")
+	(unspec:SI [(match_operand:SI 1 "register_operand")
+		    (match_operand:SI 2 "register_operand")]
+		   UNSPEC_XLISTFIND_INDEX))]
+  "TARGET_XLISTFIND && !TARGET_64BIT"
+{
+  rtx idx16 = gen_reg_rtx (HImode);
+  rtx idx = gen_reg_rtx (SImode);
