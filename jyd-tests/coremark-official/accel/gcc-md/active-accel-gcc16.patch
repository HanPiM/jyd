+;; In-place singly-linked list reversal (xlistrev): two fused instructions
+;; operating on the head pointer; the result is the new head.  The "0"
+;; matching constraint keeps rd == rs1 == the same register, mirroring the
+;; read-write inline-asm operand.
+(define_insn "xlistrevsi2"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+	(unspec:SI [(match_operand:SI 1 "register_operand" "0")]
