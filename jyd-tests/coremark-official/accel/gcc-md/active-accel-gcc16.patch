@@ -1238,0 +1270,60 @@ pass_ch::execute (function *fun)
+/* Copy only loop headers that have the inexpensive structural prerequisites
+   of a bit-at-a-time CRC.  The subsequent CRC pass still proves the complete
+   data flow and polynomial before replacing the loop.  */
+
+bool
+pass_ch_crc::process_loop_p (class loop *loop)
+{
+  if (!loop || loop->inner)
+    return false;
+
+  tree iterations = number_of_latch_executions (loop);
+  if (!iterations || iterations == chrec_dont_know
+      || !tree_fits_uhwi_p (iterations))
+    return false;
+
+  unsigned HOST_WIDE_INT n = tree_to_uhwi (iterations);
+  if (n != 8 && n != 16 && n != 24 && n != 32 && n != 64)
+    return false;
+
+  bool has_xor = false;
+  bool has_shift_one = false;
+  unsigned int conditional_bbs = 0;
+  basic_block *bbs = get_loop_body (loop);
+  for (unsigned int i = 0; i < loop->num_nodes; ++i)
+    {
+      basic_block bb = bbs[i];
+      if (!single_succ_p (bb))
+	++conditional_bbs;
+
+      for (gimple_stmt_iterator gsi = gsi_start_nondebug_bb (bb);
+	   !gsi_end_p (gsi); gsi_next_nondebug (&gsi))
+	{
+	  gimple *stmt = gsi_stmt (gsi);
+	  if (!is_gimple_assign (stmt))
+	    continue;
+
+	  enum tree_code code = gimple_assign_rhs_code (stmt);
+	  if (code == BIT_XOR_EXPR)
+	    has_xor = true;
+	  else if ((code == LSHIFT_EXPR || code == RSHIFT_EXPR)
+		   && gimple_assign_rhs2 (stmt)
+		   && integer_onep (gimple_assign_rhs2 (stmt)))
+	    has_shift_one = true;
+	}
+    }
+  free (bbs);
+  return conditional_bbs == 2 && has_xor && has_shift_one;
+}
+
+unsigned int
+pass_ch_crc::execute (function *fun)
+{
+  loop_optimizer_init (LOOPS_NORMAL | LOOPS_HAVE_RECORDED_EXITS);
+  scev_initialize ();
+  unsigned int res = copy_headers (fun);
+  scev_finalize ();
+  loop_optimizer_finalize ();
+  return res;
+}
