diff --git a/gcc/config/riscv/riscv.opt b/gcc/config/riscv/riscv.opt
index 2c26ee99691..5f4a5c98f70 100644
--- a/gcc/config/riscv/riscv.opt
+++ b/gcc/config/riscv/riscv.opt
@@ -83,0 +84,52 @@ Use hardware instructions for integer division.
+mxbmul
+Target Mask(XBMUL)
+Recognize packed bit-field multiply expressions and use the custom xbmul instruction.
+
+mxmbm
+Target Mask(XMBM)
+Recognize packed bit-field multiply expressions and use the two-source custom xmbm instruction.
+
+mxcrcu8
+Target Var(riscv_xcrcu8) Init(0)
+Use the custom byte-wise CRC16 instruction.
+
+mxdup8lo
+Target Mask(XDUP8LO)
+Copy byte 1 into byte 0 while preserving the upper 24 bits.
+
+mclipped-rising-score-reduce
+Target Var(riscv_clipped_rising_score_reduce) Init(0)
+Use the clipped rising-score sequence reduction instruction.
+
+mxlistrev
+Target Mask(XLISTREV)
+Use the in-place singly-linked list reversal instruction.
+
+mxlistfind
+Target Mask(XLISTFIND)
+Use the fused linked-list search instructions.
+
+mxmacacc
+Target Mask(XMACACC)
+Use the matrix multiply-accumulate instruction sequence.
+
+mxpaddh2
+Target Mask(XPADDH2)
+Use packed halfword scalar-add instructions for matched in-place loops.
+
+mxdotn
+Target Mask(XDOTN)
+Use runtime-sized strided matrix dot-product instructions.
+
+mxdfa4h
+Target Mask(XDFA4H)
+Use the numeric-token DFA (xdfa4h) instructions.
+
+mxdfa4p
+Target Mask(XDFA4P)
+Use the in-place pointer numeric-token DFA (xdfa4p) instructions.
+
+mxdfascan
+Target Mask(XDFASCAN)
+Use the whole-string numeric-token DFA scan instruction.
+
diff --git a/gcc/gimple-crc-optimization.cc b/gcc/gimple-crc-optimization.cc
index e69bc2935eb..a924312c82d 100644
--- a/gcc/gimple-crc-optimization.cc
+++ b/gcc/gimple-crc-optimization.cc
@@ -36,0 +37 @@ along with GCC; see the file COPYING3.  If not see
+#include "attribs.h"
@@ -247,0 +249,118 @@ class crc_optimization {
+/* Return true when FUN is a small, side-effect-free wrapper whose only calls
+   are CRC internal functions.  Such wrappers can be propagated through LTO
+   without enabling general-purpose interprocedural inlining.  */
+
+static bool
+crc_semantic_wrapper_p (function *fun)
+{
+  bool has_crc = false;
+  unsigned int statement_count = 0;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, fun)
+    for (gimple_stmt_iterator gsi = gsi_start_nondebug_bb (bb);
+	 !gsi_end_p (gsi); gsi_next_nondebug (&gsi))
+      {
+	gimple *stmt = gsi_stmt (gsi);
+	if (++statement_count > 128 || gimple_has_volatile_ops (stmt))
+	  return false;
+
+	switch (gimple_code (stmt))
+	  {
+	  case GIMPLE_CALL:
+	    if (gimple_call_internal_p (stmt, IFN_CRC)
+		|| gimple_call_internal_p (stmt, IFN_CRC_REV))
+	      has_crc = true;
+	    else
+	      return false;
+	    break;
+
+	  case GIMPLE_ASSIGN:
+	    if (gimple_store_p (stmt) || gimple_vuse (stmt))
+	      return false;
+	    break;
+
+	  case GIMPLE_COND:
+	  case GIMPLE_GOTO:
+	  case GIMPLE_LABEL:
+	  case GIMPLE_NOP:
+	  case GIMPLE_PHI:
+	  case GIMPLE_PREDICT:
+	  case GIMPLE_RETURN:
+	    break;
+
+	  default:
+	    return false;
+	  }
+      }
+  return has_crc;
+}
+
+static bool
+target_supports_crc_semantic_lto_p ()
+{
+  tree data_type = build_nonstandard_integer_type (8, 1);
+  tree result_type = build_nonstandard_integer_type (16, 1);
+  return direct_internal_fn_supported_p (IFN_CRC_REV,
+					 tree_pair (data_type, result_type),
+					 OPTIMIZE_FOR_BOTH);
+}
+
+static void
+add_function_attribute (tree decl, const char *name)
+{
+  if (!lookup_attribute (name, DECL_ATTRIBUTES (decl)))
+    DECL_ATTRIBUTES (decl)
+      = tree_cons (get_identifier (name), NULL_TREE, DECL_ATTRIBUTES (decl));
+}
+
+static bool
+function_has_indirect_call_p (function *fun)
+{
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, fun)
+    for (gimple_stmt_iterator gsi = gsi_start_nondebug_bb (bb);
+	 !gsi_end_p (gsi); gsi_next_nondebug (&gsi))
+      {
+	gcall *call = dyn_cast<gcall *> (gsi_stmt (gsi));
+	if (call && !gimple_call_internal_p (call)
+	    && !gimple_call_fndecl (call))
+	  return true;
+      }
+  return false;
+}
+
+static void
+mark_crc_semantic_lto_function (function *fun)
+{
+  if (!flag_lto || !flag_crc_semantic_lto
+      || !target_supports_crc_semantic_lto_p ())
+    return;
+
+  tree decl = fun->decl;
+  add_function_attribute (decl, "crc_semantic_lto");
+  if (crc_semantic_wrapper_p (fun))
+    {
+      DECL_DECLARED_INLINE_P (decl) = 1;
+      DECL_DISREGARD_INLINE_LIMITS (decl) = 1;
+      add_function_attribute (decl, "always_inline");
+      add_function_attribute (decl, "crc_semantic_wrapper");
+
+      if (dump_file)
+	fprintf (dump_file, "Marked CRC semantic wrapper for LTO inlining.\n");
+      return;
+    }
+
+  /* Preserve ordinary per-translation-unit optimization while preventing
+     whole-program cloning and folding from duplicating accelerator sites.  */
+  add_function_attribute (decl, "noclone");
+  add_function_attribute (decl, "no_icf");
+  if (function_has_indirect_call_p (fun))
+    {
+      add_function_attribute (decl, "noinline");
+      DECL_UNINLINABLE (decl) = 1;
+    }
+
+  if (dump_file)
+    fprintf (dump_file, "Protected non-CRC function from LTO cloning.\n");
+}
+
@@ -1379,0 +1499,13 @@ namespace
+    const pass_data pass_data_crc_semantic_wrappers
+	= {
+	    GIMPLE_PASS, /* type */
+	    "crc_inline", /* name */
+	    OPTGROUP_NONE, /* optinfo_flags */
+	    TV_GIMPLE_CRC_OPTIMIZATION, /* tv_id */
+	    (PROP_cfg | PROP_ssa), /* properties_required */
+	    0, /* properties_provided */
+	    0, /* properties_destroyed */
+	    0, /* todo_flags_start */
+	    0, /* todo_flags_finish */
+	};
+
@@ -1392,0 +1525,4 @@ namespace
+      opt_pass *clone () final override
+      {
+	return new pass_crc_optimization (m_ctxt);
+      }
@@ -1395,0 +1532,18 @@ namespace
+    class pass_crc_semantic_wrappers : public gimple_opt_pass {
+     public:
+      pass_crc_semantic_wrappers (gcc::context *ctxt)
+	  : gimple_opt_pass (pass_data_crc_semantic_wrappers, ctxt)
+      {}
+
+      bool gate (function *) final override
+      {
+	return flag_optimize_crc && flag_crc_semantic_lto;
+      }
+
+      unsigned int execute (function *fun) final override
+      {
+	mark_crc_semantic_lto_function (fun);
+	return 0;
+      }
+    }; // class pass_crc_semantic_wrappers
+
@@ -1408,0 +1563,6 @@ make_pass_crc_optimization (gcc::context *ctxt)
+
+gimple_opt_pass *
+make_pass_crc_semantic_wrappers (gcc::context *ctxt)
+{
+  return new pass_crc_semantic_wrappers (ctxt);
+}
diff --git a/gcc/internal-fn.cc b/gcc/internal-fn.cc
index 25acc63b247..be154de7d17 100644
--- a/gcc/internal-fn.cc
+++ b/gcc/internal-fn.cc
@@ -40,0 +41 @@ along with GCC; see the file COPYING3.  If not see
+#include "insn-flags.h"
@@ -3466,0 +3468,342 @@ expand_UNIQUE (internal_fn, gcall *stmt)
+/* Reset the hardware numeric-DFA counters (xdfa4h).  */
+static void
+expand_XDFACNT_INIT (internal_fn, gcall *)
+{
+  emit_insn (gen_xdfacnt_init_si ());
+}
+
+static rtx
+xmacacc_add (rtx lhs, rtx rhs)
+{
+  rtx out = gen_reg_rtx (SImode);
+  emit_insn (gen_addsi3 (out, lhs, rhs));
+  return out;
+}
+
+static rtx
+xmacacc_shift (rtx value, int amount)
+{
+  rtx out = gen_reg_rtx (SImode);
+  emit_insn (gen_ashlsi3 (out, value, GEN_INT (amount)));
+  return out;
+}
+
+static rtx
+xmacacc_load_half (rtx address)
+{
+  rtx half = gen_reg_rtx (HImode);
+  rtx value = gen_reg_rtx (SImode);
+  emit_move_insn (half, gen_rtx_MEM (HImode, address));
+  emit_insn (gen_extendhisi2 (value, half));
+  return value;
+}
+
+/* Emit three nested matrix loops for the matched matrix-accumulation
+   data-flow shape.  */
+static void
+expand_xmacacc_matrix (gcall *stmt, bool bit_extract)
+{
+  rtx n = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 0)));
+  rtx c = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 1)));
+  rtx a = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 2)));
+  rtx b = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 3)));
+  rtx a_row = copy_to_mode_reg (SImode, a);
+  rtx b_col = copy_to_mode_reg (SImode, b);
+  rtx c_ptr = copy_to_mode_reg (SImode, c);
+  rtx outer = gen_label_rtx ();
+  rtx inner = gen_label_rtx ();
+  rtx accum = gen_label_rtx ();
+  rtx last = gen_label_rtx ();
+  rtx single = gen_label_rtx ();
+  rtx done = gen_label_rtx ();
+  rtx one = GEN_INT (1);
+
+  /* Use a row walker for small disjoint matrices and a dot walker for larger
+     disjoint matrices.  Preserve the original memory update order when the
+     output overlaps either input.  */
+  if (TARGET_XDOTN)
+    {
+      rtx generic = gen_label_rtx ();
+      rtx scalar_fallback = gen_label_rtx ();
+      rtx scalar_outer = gen_label_rtx ();
+      rtx scalar_inner = gen_label_rtx ();
+      rtx scalar_accum = gen_label_rtx ();
+      rtx dot_fallback = gen_label_rtx ();
+      rtx row_check_b = gen_label_rtx ();
+      rtx row_range_ok = gen_label_rtx ();
+      rtx row_outer = gen_label_rtx ();
+      rtx dot_outer = gen_label_rtx ();
+      rtx dot_inner = gen_label_rtx ();
+      rtx dot_step = xmacacc_shift (n, 1);
+      rtx dot_elements = gen_reg_rtx (SImode);
+      emit_insn (gen_mulsi3 (dot_elements, n, n));
+      rtx dot_a_end = xmacacc_add (a, xmacacc_shift (dot_elements, 1));
+      rtx dot_b_full_end = xmacacc_add (b, xmacacc_shift (dot_elements, 1));
+      rtx dot_c_step = xmacacc_shift (dot_elements, 2);
+      rtx dot_c_end = xmacacc_add (c, dot_c_step);
+      rtx dot_b_end = xmacacc_add (b, dot_step);
+
+      emit_cmp_and_jump_insns (n, const0_rtx, EQ, NULL_RTX, SImode, 1,
+			       generic, profile_probability::very_unlikely ());
+      emit_cmp_and_jump_insns (n, GEN_INT (32767), GTU, NULL_RTX, SImode, 1,
+			       generic, profile_probability::very_unlikely ());
+      emit_cmp_and_jump_insns (dot_a_end, a, LTU, NULL_RTX, SImode, 1,
+			       scalar_fallback, profile_probability::very_unlikely ());
+      emit_cmp_and_jump_insns (dot_b_full_end, b, LTU, NULL_RTX, SImode, 1,
+			       scalar_fallback, profile_probability::very_unlikely ());
+      emit_cmp_and_jump_insns (dot_c_end, c, LTU, NULL_RTX, SImode, 1,
+			       scalar_fallback, profile_probability::very_unlikely ());
+      emit_cmp_and_jump_insns (dot_c_end, a, LEU, NULL_RTX, SImode, 1,
+			       row_check_b, profile_probability::even ());
+      emit_cmp_and_jump_insns (dot_a_end, c, LEU, NULL_RTX, SImode, 1,
+			       row_check_b, profile_probability::even ());
+      emit_jump_insn (gen_jump (scalar_fallback));
+      emit_barrier ();
+      emit_label (row_check_b);
+      emit_cmp_and_jump_insns (dot_c_end, b, LEU, NULL_RTX, SImode, 1,
+			       row_range_ok, profile_probability::even ());
+      emit_cmp_and_jump_insns (dot_b_full_end, c, GTU, NULL_RTX, SImode, 1,
+			       scalar_fallback, profile_probability::even ());
+      emit_label (row_range_ok);
+      emit_cmp_and_jump_insns (n, GEN_INT (4), LTU, NULL_RTX, SImode, 1,
+			       dot_fallback, profile_probability::unlikely ());
+      emit_cmp_and_jump_insns (n, GEN_INT (16), GTU, NULL_RTX, SImode, 1,
+			       dot_fallback, profile_probability::unlikely ());
+      emit_label (row_outer);
+      emit_insn (gen_xdotn_configsi2 (n, c_ptr));
+      emit_insn (bit_extract ? gen_xdotrow_bitsi2 (a_row, b) : gen_xdotrowsi2 (a_row, b));
+      emit_insn (gen_addsi3 (c_ptr, c_ptr, dot_step));
+      emit_insn (gen_addsi3 (c_ptr, c_ptr, dot_step));
+      emit_insn (gen_addsi3 (a_row, a_row, dot_step));
+      emit_cmp_and_jump_insns (a_row, dot_a_end, NE, NULL_RTX, SImode, 1,
+			       row_outer, profile_probability::likely ());
+      emit_jump_insn (gen_jump (done));
+      emit_barrier ();
+      emit_label (dot_fallback);
+      emit_label (dot_outer);
+      emit_move_insn (b_col, b);
+      /* Besides refreshing the state for each row, the configuration op
+	 separates the loop's b_col move from the blocking dot consumer.  */
+      emit_insn (gen_xdotn_configsi2 (n, c_ptr));
+      emit_label (dot_inner);
+      rtx dot_result = gen_reg_rtx (SImode);
+      emit_insn (bit_extract
+			 ? gen_xdotn_bitsi3 (dot_result, a_row, b_col)
+			 : gen_xdotnsi3 (dot_result, a_row, b_col));
+      emit_move_insn (gen_rtx_MEM (SImode, c_ptr), dot_result);
+      emit_insn (gen_addsi3 (c_ptr, c_ptr, GEN_INT (4)));
+      emit_insn (gen_addsi3 (b_col, b_col, GEN_INT (2)));
+      emit_cmp_and_jump_insns (b_col, dot_b_end, NE, NULL_RTX, SImode, 1,
+			       dot_inner, profile_probability::likely ());
+      emit_insn (gen_addsi3 (a_row, a_row, dot_step));
+      emit_cmp_and_jump_insns (a_row, dot_a_end, NE, NULL_RTX, SImode, 1,
+			       dot_outer, profile_probability::likely ());
+      emit_jump_insn (gen_jump (done));
+      emit_barrier ();
+      emit_label (scalar_fallback);
+      rtx scalar_a_ptr = gen_reg_rtx (SImode);
+      rtx scalar_b_ptr = gen_reg_rtx (SImode);
+      rtx scalar_a_limit = gen_reg_rtx (SImode);
+      rtx scalar_product = gen_reg_rtx (SImode);
+      rtx scalar_term = gen_reg_rtx (SImode);
+      rtx scalar_current = gen_reg_rtx (SImode);
+      rtx scalar_sum = gen_reg_rtx (SImode);
+      emit_label (scalar_outer);
+      emit_move_insn (b_col, b);
+      emit_label (scalar_inner);
+      emit_move_insn (scalar_a_ptr, a_row);
+      emit_move_insn (scalar_b_ptr, b_col);
+      emit_insn (gen_addsi3 (scalar_a_limit, a_row, dot_step));
+      emit_move_insn (gen_rtx_MEM (SImode, c_ptr), const0_rtx);
+      emit_label (scalar_accum);
+      rtx scalar_av = xmacacc_load_half (scalar_a_ptr);
+      rtx scalar_bv = xmacacc_load_half (scalar_b_ptr);
+      emit_insn (gen_mulsi3 (scalar_product, scalar_av, scalar_bv));
+      if (bit_extract)
+	{
+	  rtx lo = gen_reg_rtx (SImode);
+	  rtx hi = gen_reg_rtx (SImode);
+	  emit_insn (gen_lshrsi3 (lo, scalar_product, GEN_INT (2)));
+	  emit_insn (gen_andsi3 (lo, lo, GEN_INT (15)));
+	  emit_insn (gen_lshrsi3 (hi, scalar_product, GEN_INT (5)));
+	  emit_insn (gen_andsi3 (hi, hi, GEN_INT (127)));
+	  emit_insn (gen_mulsi3 (scalar_term, lo, hi));
+	}
+      else
+	emit_move_insn (scalar_term, scalar_product);
+      emit_move_insn (scalar_current, gen_rtx_MEM (SImode, c_ptr));
+      emit_insn (gen_addsi3 (scalar_sum, scalar_current, scalar_term));
+      emit_move_insn (gen_rtx_MEM (SImode, c_ptr), scalar_sum);
+      emit_insn (gen_addsi3 (scalar_a_ptr, scalar_a_ptr, GEN_INT (2)));
+      emit_insn (gen_addsi3 (scalar_b_ptr, scalar_b_ptr, dot_step));
+      emit_cmp_and_jump_insns (scalar_a_ptr, scalar_a_limit, NE, NULL_RTX,
+			       SImode, 1, scalar_accum,
+			       profile_probability::likely ());
+      emit_insn (gen_addsi3 (c_ptr, c_ptr, GEN_INT (4)));
+      emit_insn (gen_addsi3 (b_col, b_col, GEN_INT (2)));
+      emit_cmp_and_jump_insns (b_col, dot_b_end, NE, NULL_RTX, SImode, 1,
+			       scalar_inner, profile_probability::likely ());
+      emit_insn (gen_addsi3 (a_row, a_row, dot_step));
+      emit_cmp_and_jump_insns (a_row, dot_a_end, NE, NULL_RTX, SImode, 1,
+			       scalar_outer, profile_probability::likely ());
+      emit_jump_insn (gen_jump (done));
+      emit_barrier ();
+      emit_label (generic);
+    }
+
+  emit_cmp_and_jump_insns (n, one, LEU, NULL_RTX, SImode, 1, single,
+			   profile_probability::very_unlikely ());
+  rtx b_step = xmacacc_shift (n, 1);
+  rtx elements = gen_reg_rtx (SImode);
+  emit_insn (gen_mulsi3 (elements, n, n));
+  rtx a_end = xmacacc_add (a, xmacacc_shift (elements, 1));
+  rtx b_end = xmacacc_add (b, b_step);
+
+  emit_label (outer);
+  emit_move_insn (b_col, b);
+  emit_label (inner);
+  rtx a_ptr = copy_to_mode_reg (SImode, a_row);
+  rtx b_ptr = copy_to_mode_reg (SImode, b_col);
+  rtx last_a = xmacacc_add (a_row, xmacacc_add (b_step, GEN_INT (-2)));
+
+  rtx av = xmacacc_load_half (a_ptr);
+  rtx bv = xmacacc_load_half (b_ptr);
+  rtx ignored = gen_reg_rtx (SImode);
+  emit_insn (bit_extract
+		     ? gen_xmacacc_bit_firstsi3 (ignored, av, bv)
+		     : gen_xmacacc_firstsi3 (ignored, av, bv));
+  emit_insn (gen_addsi3 (a_ptr, a_ptr, GEN_INT (2)));
+  emit_insn (gen_addsi3 (b_ptr, b_ptr, b_step));
+  emit_cmp_and_jump_insns (a_ptr, last_a, EQ, NULL_RTX, SImode, 1, last,
+			   profile_probability::even ());
+
+  emit_label (accum);
+  av = xmacacc_load_half (a_ptr);
+  bv = xmacacc_load_half (b_ptr);
+  ignored = gen_reg_rtx (SImode);
+  emit_insn (bit_extract
+		     ? gen_xmacacc_bit_addsi3 (ignored, av, bv)
+		     : gen_xmacacc_addsi3 (ignored, av, bv));
+  emit_insn (gen_addsi3 (a_ptr, a_ptr, GEN_INT (2)));
+  emit_insn (gen_addsi3 (b_ptr, b_ptr, b_step));
+  emit_cmp_and_jump_insns (a_ptr, last_a, NE, NULL_RTX, SImode, 1, accum,
+			   profile_probability::likely ());
+
+  emit_label (last);
+  av = xmacacc_load_half (a_ptr);
+  bv = xmacacc_load_half (b_ptr);
+  rtx result = gen_reg_rtx (SImode);
+  emit_insn (bit_extract
+		     ? gen_xmacacc_bit_lastsi3 (result, av, bv)
+		     : gen_xmacacc_lastsi3 (result, av, bv));
+  emit_move_insn (gen_rtx_MEM (SImode, c_ptr), result);
+  emit_insn (gen_addsi3 (c_ptr, c_ptr, GEN_INT (4)));
+  emit_insn (gen_addsi3 (b_col, b_col, GEN_INT (2)));
+  emit_cmp_and_jump_insns (b_col, b_end, NE, NULL_RTX, SImode, 1, inner,
+			   profile_probability::likely ());
+  emit_insn (gen_addsi3 (a_row, a_row, b_step));
+  emit_cmp_and_jump_insns (a_row, a_end, NE, NULL_RTX, SImode, 1, outer,
+			   profile_probability::likely ());
+  emit_jump_insn (gen_jump (done));
+  emit_barrier ();
+
+  emit_label (single);
+  emit_cmp_and_jump_insns (n, const0_rtx, EQ, NULL_RTX, SImode, 1, done,
+			   profile_probability::very_unlikely ());
+  av = xmacacc_load_half (a);
+  bv = xmacacc_load_half (b);
+  result = gen_reg_rtx (SImode);
+  emit_insn (gen_mulsi3 (result, av, bv));
+  if (bit_extract)
+    {
+      rtx lo = gen_reg_rtx (SImode);
+      rtx hi = gen_reg_rtx (SImode);
+      emit_insn (gen_lshrsi3 (lo, result, GEN_INT (2)));
+      emit_insn (gen_andsi3 (lo, lo, GEN_INT (15)));
+      emit_insn (gen_lshrsi3 (hi, result, GEN_INT (5)));
+      emit_insn (gen_andsi3 (hi, hi, GEN_INT (127)));
+      emit_insn (gen_mulsi3 (result, lo, hi));
+    }
+  emit_move_insn (gen_rtx_MEM (SImode, c), result);
+  emit_label (done);
+}
+
+static void
+expand_XMACACC_MATRIX (internal_fn, gcall *stmt)
+{
+  expand_xmacacc_matrix (stmt, false);
+}
+
+static void
+expand_XMACACC_BIT_MATRIX (internal_fn, gcall *stmt)
+{
+  expand_xmacacc_matrix (stmt, true);
+}
+
+static void
+xpaddh2_scalar_update (rtx address, rtx addend)
+{
+  rtx half = gen_reg_rtx (HImode);
+  rtx value = gen_reg_rtx (SImode);
+  rtx sum = gen_reg_rtx (SImode);
+  emit_move_insn (half, gen_rtx_MEM (HImode, address));
+  emit_insn (gen_zero_extendhisi2 (value, half));
+  emit_insn (gen_addsi3 (sum, value, addend));
+  emit_move_insn (gen_rtx_MEM (HImode, address), gen_lowpart (HImode, sum));
+}
+
+/* Expand a matched square int16 matrix scalar-add loop.  Any defined source
+   execution has an addressable N*N-element object, so the 32-bit element and
+   byte counts cannot wrap.  Peel a 2-byte-aligned first element when needed,
+   process aligned pairs, and retain a scalar tail for an odd element count.  */
+static void
+expand_XPADDH2_MATRIX_ADD (internal_fn, gcall *stmt)
+{
+  rtx n = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 0)));
+  rtx base = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 1)));
+  rtx raw_addend = expand_normal (gimple_call_arg (stmt, 2));
+  rtx addend = force_reg (SImode,
+			 convert_to_mode (SImode, raw_addend, true));
+  rtx elements = gen_reg_rtx (SImode);
+  emit_insn (gen_mulsi3 (elements, n, n));
+  rtx bytes = xmacacc_shift (elements, 1);
+  rtx end = xmacacc_add (base, bytes);
+  rtx ptr = copy_to_mode_reg (SImode, base);
+  rtx aligned = gen_label_rtx ();
+  rtx pair = gen_label_rtx ();
+  rtx tail = gen_label_rtx ();
+  rtx done = gen_label_rtx ();
+
+  emit_cmp_and_jump_insns (elements, const0_rtx, EQ, NULL_RTX, SImode, 1,
+			   done, profile_probability::very_unlikely ());
+  rtx alignment = gen_reg_rtx (SImode);
+  emit_insn (gen_andsi3 (alignment, ptr, GEN_INT (2)));
+  emit_cmp_and_jump_insns (alignment, const0_rtx, EQ, NULL_RTX, SImode, 1,
+			   aligned, profile_probability::likely ());
+  xpaddh2_scalar_update (ptr, addend);
+  emit_insn (gen_addsi3 (ptr, ptr, GEN_INT (2)));
+  emit_cmp_and_jump_insns (ptr, end, EQ, NULL_RTX, SImode, 1, done,
+			   profile_probability::unlikely ());
+
+  emit_label (aligned);
+  rtx pair_end = gen_reg_rtx (SImode);
+  emit_insn (gen_andsi3 (pair_end, end, GEN_INT (-4)));
+  emit_cmp_and_jump_insns (ptr, pair_end, EQ, NULL_RTX, SImode, 1, tail,
+			   profile_probability::unlikely ());
+  emit_label (pair);
+  rtx word = gen_reg_rtx (SImode);
+  rtx result = gen_reg_rtx (SImode);
+  emit_move_insn (word, gen_rtx_MEM (SImode, ptr));
+  emit_insn (gen_xpaddh2si3 (result, word, addend));
+  emit_move_insn (gen_rtx_MEM (SImode, ptr), result);
+  emit_insn (gen_addsi3 (ptr, ptr, GEN_INT (4)));
+  emit_cmp_and_jump_insns (ptr, pair_end, NE, NULL_RTX, SImode, 1, pair,
+			   profile_probability::likely ());
+
+  emit_label (tail);
+  emit_cmp_and_jump_insns (ptr, end, EQ, NULL_RTX, SImode, 1, done,
+			   profile_probability::likely ());
+  xpaddh2_scalar_update (ptr, addend);
+  emit_label (done);
+}
+
