+/* Rewrite core_bench_state for the xdfa4h hardware: reset the counters
+   before the first scan, replace each transition call with the step
+   loop, and read the counters from hardware in the CRC epilogue.  */
+static void
+rewrite_xdfa4h_bench (vec<gcall *> &calls, tree tc, tree fc)
+{
+  /* Counter reset in the preheader of the first scan loop.  */
+  basic_block body = gimple_bb (calls[0]);
+  basic_block hdr = EDGE_PRED (body, 0)->src;
+  basic_block pre = NULL;
+  for (unsigned i = 0; i < EDGE_COUNT (hdr->preds); ++i)
+    if (EDGE_PRED (hdr, i)->src != body)
+      pre = EDGE_PRED (hdr, i)->src;
+  if (!pre)
+    return;
+  gimple_stmt_iterator gsi = gsi_last_bb (pre);
+  gcall *init = gimple_build_call_internal (IFN_XDFACNT_INIT, 0);
+  gimple_set_vuse (init, gimple_vop (cfun));
+  gsi_insert_before (&gsi, init, GSI_SAME_STMT);
+
+  /* Replace the transition calls with step loops.  */
+  for (unsigned i = 0; i < calls.length (); ++i)
+    replace_xdfa4h_transition_call (calls[i]);
+
+  /* Hardware records both transition and final-state counters.  Remove the
+     now-redundant software final-count updates before reading both classes
+     of counters in the CRC epilogue.  */
+  if (fc)
+    {
+      basic_block bb;
+      FOR_EACH_BB_FN (bb, cfun)
+	for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	     !gsi_end_p (gsi); )
+	  {
+	    gimple *s = gsi_stmt (gsi);
+	    if (is_gimple_assign (s))
+	      {
+		tree lhs = gimple_assign_lhs (s);
+		if ((TREE_CODE (lhs) == ARRAY_REF
+		     && TREE_OPERAND (lhs, 0) == fc)
+		    || (TREE_CODE (lhs) == MEM_REF
+			&& counts_ref_base_decl (lhs) == fc))
+		  {
+		    if (gimple_vdef (s))
+		      mark_virtual_operand_for_renaming (gimple_vdef (s));
+		    gsi_remove (&gsi, true);
+		    continue;
+		  }
+	      }
+	    gsi_next (&gsi);
+	  }
+    }
+
+  /* Read the hardware counters in the CRC epilogue.  */
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gs2 = gsi_start_bb (bb);
+	 !gsi_end_p (gs2); gsi_next (&gs2))
+      {
+	gimple *s = gsi_stmt (gs2);
+	if (!is_gimple_assign (s))
+	  continue;
+	tree rhs = gimple_assign_rhs1 (s);
+	if (gimple_assign_rhs_code (s) == ARRAY_REF)
+	  {
+	    tree base = TREE_OPERAND (rhs, 0);
+	    if (base != tc && base != fc)
+	      continue;
+	  }
+	else if (gimple_assign_rhs_code (s) == MEM_REF)
+	  {
+	    tree base = counts_ref_base_decl (rhs);
+	    if (base != tc && base != fc)
+	      continue;
+	  }
+	else
+	  continue;
+	tree idx = counts_ref_index (rhs);
+	if (!idx)
+	  continue;
+
+	/* Fresh lhs for the hardware read; rewire the old load's uses
+	   so releasing the load cannot invalidate them.  */
+	tree old_lhs = gimple_assign_lhs (s);
+	tree new_lhs = make_ssa_name (TREE_TYPE (old_lhs));
+	replace_uses_by (old_lhs, new_lhs);
+	/* gsi_replace requires matching LHSes; the load is dead after the
+	   use rewrite, so re-point its lhs at the new name.  */
+	gimple_set_lhs (s, new_lhs);
+	tree idx32 = make_ssa_name (unsigned_type_node);
+	gsi_insert_before (&gs2,
+			   gimple_build_assign (idx32, NOP_EXPR, idx),
+			   GSI_SAME_STMT);
+	bool is_final = (gimple_assign_rhs_code (s) == ARRAY_REF
+			 ? TREE_OPERAND (rhs, 0) == fc
+			 : counts_ref_base_decl (rhs) == fc);
+	gcall *read = gimple_build_call_internal
+	  (is_final ? IFN_XDFA4H_FINAL_READ : IFN_XDFA4H_READ, 1, idx32);
+	gimple_call_set_lhs (read, new_lhs);
+	gimple_set_vuse (read, gimple_vop (cfun));
+	/* Hand the replaced load's vdef to the renamer before the
+	   release inside gsi_replace.  */
+	if (gimple_vdef (s))
+	  mark_virtual_operand_for_renaming (gimple_vdef (s));
+	gsi_replace (&gs2, read, true);
+      }
+}
+
+const pass_data pass_data_clipped_rising_score = {
+  GIMPLE_PASS, "clippedscore", OPTGROUP_NONE, TV_TREE_LOOP,
+  PROP_cfg | PROP_ssa, 0, 0, 0, TODO_cleanup_cfg | TODO_update_ssa
+};
+
+class pass_clipped_rising_score : public gimple_opt_pass
+{
+public:
+  pass_clipped_rising_score (gcc::context *ctxt)
+    : gimple_opt_pass (pass_data_clipped_rising_score, ctxt) {}
+  bool gate (function *) final override
+  {
+    return (riscv_clipped_rising_score_reduce || TARGET_XLISTREV
+	    || TARGET_XDFA4H);
+  }
+
+  static bool try_clipped_rising_score ()
+  {
+    tree args = DECL_ARGUMENTS (cfun->decl);
+    if (!args || !DECL_CHAIN (args) || !DECL_CHAIN (DECL_CHAIN (args))
+	|| DECL_CHAIN (DECL_CHAIN (DECL_CHAIN (args))))
+      return false;
+    tree n = args, base = DECL_CHAIN (n), clip = DECL_CHAIN (base);
+    if (TYPE_PRECISION (TREE_TYPE (n)) != 32
+	|| !POINTER_TYPE_P (TREE_TYPE (base))
+	|| TYPE_PRECISION (TREE_TYPE (TREE_TYPE (base))) != 32
+	|| TYPE_PRECISION (TREE_TYPE (clip)) != 16
+	|| TYPE_PRECISION (TREE_TYPE (TREE_TYPE (cfun->decl))) != 16
+	|| !clipped_rising_score_p (n, base, clip))
+      return false;
+    replace_with_internal_call (n, base, clip);
+    if (dump_file)
+      fprintf (dump_file, "recognized clipped rising-score reduction\n");
+    return true;
+  }
+
+  static bool try_list_reverse ()
+  {
+    tree param = DECL_ARGUMENTS (cfun->decl);
+    if (!list_reverse_p (param))
+      return false;
+    replace_list_reverse (param);
+    if (dump_file)
+      fprintf (dump_file, "recognized in-place list reversal\n");
+    return true;
+  }
+
+  static bool try_xdfa4h_bench ()
+  {
+    vec<gcall *> calls = vNULL;
+    tree tc = NULL_TREE, fc = NULL_TREE;
+    if (!find_xdfa4h_bench (calls, &tc, &fc))
+      {
+	calls.release ();
+	return false;
+      }
+    rewrite_xdfa4h_bench (calls, tc, fc);
+    calls.release ();
+    /* The step loops and the counter-read epilogue extend the CFG; the
+       dominator tree no longer describes it.  update_ssa recomputes
+       dominance info when it is marked not computed.  */
+    free_dominance_info (CDI_DOMINATORS);
+    if (dump_file)
+      fprintf (dump_file, "recognized numeric-token DFA scan\n");
+    return true;
+  }
+
+  unsigned int execute (function *) final override
+  {
+    unsigned int todo = 0;
+    if (riscv_clipped_rising_score_reduce && try_clipped_rising_score ())
+      todo |= TODO_cleanup_cfg | TODO_update_ssa;
+    if (TARGET_XLISTREV && try_list_reverse ())
+      todo |= TODO_cleanup_cfg | TODO_update_ssa;
+    if (TARGET_XDFA4H && try_xdfa4h_bench ())
+      todo |= TODO_cleanup_cfg | TODO_update_ssa;
+    return todo;
+  }
+};
+
+} // anonymous namespace
+
+gimple_opt_pass *
+make_pass_clipped_rising_score (gcc::context *ctxt)
+{
+  return new pass_clipped_rising_score (ctxt);
+}
