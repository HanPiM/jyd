+
+/* -------------------------------------------------------------------------- */
+/* In-place singly-linked list reversal (xlistrev).                             */
+/* -------------------------------------------------------------------------- */
+
+/* Match the canonical reversal loop:
+     <body>:
+       tmp = list->next;
+       list->next = next;
+     <header>:
+       # list = PHI <param, tmp>
+       # next = PHI <NULL, list>
+       if (list != 0B) goto <body>; else goto <exit>;
+     <exit>:
+       return next;
+   Any function with exactly this shape is an in-place list reversal, so the
+   lowering is selected only after the complete data-flow shape is verified.  */
+
+/* The list head is a structure with the next pointer at some fixed
+   offset; the frontend may emit the field access as either a
+   COMPONENT_REF (p->next) or a MEM_REF (after folding).  Both put the
+   object in operand 0; the "key" identifying the field is the
+   FIELD_DECL for COMPONENT_REF or the byte offset for MEM_REF.  */
+static tree
+ref_key (tree ref)
+{
+  return TREE_OPERAND (ref, 1);
+}
+
+static bool
+same_ref_key (tree a, tree b)
+{
+  if (a == b)
+    return true;
+  return (TREE_CODE (a) == INTEGER_CST && TREE_CODE (b) == INTEGER_CST
+	  && tree_int_cst_equal (a, b));
+}
+
+/* Peel nested COMPONENT_REF/MEM_REF nodes off a reference until the object
+   is an SSA name (p->next is often COMPONENT_REF over a zero-offset
+   MEM_REF of the pointer).  */
+static tree
+ref_root_ssa (tree ref)
+{
+  tree cur = ref;
+  while (cur)
+    {
+      if (TREE_CODE (cur) == SSA_NAME)
+	return cur;
+      if (TREE_CODE (cur) == COMPONENT_REF || TREE_CODE (cur) == MEM_REF)
+	{
+	  cur = TREE_OPERAND (cur, 0);
+	  continue;
+	}
+      return NULL_TREE;
+    }
+  return NULL_TREE;
+}
+
+static bool
+bb_is_list_reverse (basic_block bb, tree param_ssa, tree *p_res, tree *n_res)
+{
+  /* Header: exactly two preds (entry chain and the loop body).  */
+  if (EDGE_COUNT (bb->preds) != 2)
+    return false;
+  tree p = NULL_TREE, n = NULL_TREE;
+  for (gphi_iterator psi = gsi_start_phis (bb);
+       !gsi_end_p (psi); gsi_next (&psi))
+    {
+      gphi *phi = psi.phi ();
+      tree res = gimple_phi_result (phi);
+      if (!POINTER_TYPE_P (TREE_TYPE (res)) || gimple_phi_num_args (phi) != 2)
+	continue;
+      tree a0 = gimple_phi_arg_def (phi, 0), a1 = gimple_phi_arg_def (phi, 1);
+      if ((a0 == param_ssa && a1 != param_ssa)
+	  || (a1 == param_ssa && a0 != param_ssa))
+	p = res;
+      if (integer_zerop (a0) ^ integer_zerop (a1))
+	n = res;
+    }
+  if (!p || !n)
+    return false;
+
+  /* Header condition: p != NULL, true edge to the body.  */
+  gimple *last = gsi_stmt (gsi_last_bb (bb));
+  if (!last || gimple_code (last) != GIMPLE_COND)
+    return false;
+  gcond *cond = as_a<gcond *> (last);
+  if (gimple_cond_code (cond) != NE_EXPR
+      || gimple_cond_lhs (cond) != p
+      || !integer_zerop (gimple_cond_rhs (cond)))
+    return false;
+  basic_block t_bb = EDGE_SUCC (bb, 0)->flags & EDGE_TRUE_VALUE
+    ? EDGE_SUCC (bb, 0)->dest : EDGE_SUCC (bb, 1)->dest;
+  basic_block f_bb = t_bb == EDGE_SUCC (bb, 0)->dest
+    ? EDGE_SUCC (bb, 1)->dest : EDGE_SUCC (bb, 0)->dest;
+  if (EDGE_COUNT (t_bb->preds) != 1 || EDGE_COUNT (t_bb->succs) != 1
+      || EDGE_SUCC (t_bb, 0)->dest != bb)
+    return false;
+  basic_block body = t_bb;
+  basic_block exit = f_bb;
+
+  /* Body: exactly one load and one store on p, storing the n phi.  */
+  tree load_res = NULL_TREE;
+  tree load_addr = NULL_TREE, store_addr = NULL_TREE;
+  unsigned n_stmts = 0;
+  for (gimple_stmt_iterator gsi = gsi_start_bb (body);
+       !gsi_end_p (gsi); gsi_next (&gsi))
+    {
+      gimple *s = gsi_stmt (gsi);
+      if (is_gimple_debug (s))
+	continue;
+      ++n_stmts;
+      if (!is_gimple_assign (s))
+	return false;
+      if (gimple_store_p (s))
+	{
+	  if (store_addr)
+	    return false;
+	  store_addr = gimple_assign_lhs (s);
+	  if (gimple_assign_rhs1 (s) != n)
+	    return false;
+	}
+      else if (gimple_assign_rhs_code (s) == MEM_REF
+	       || gimple_assign_rhs_code (s) == COMPONENT_REF)
+	{
+	  if (load_res)
+	    return false;
+	  load_res = gimple_assign_lhs (s);
+	  load_addr = gimple_assign_rhs1 (s);
+	}
+      else
+	return false;
+    }
+  if (n_stmts != 2 || !load_res || !store_addr)
+    return false;
+
+  /* The load and the store must address the same field of p, and the
+     phis must cycle exactly: list = PHI <param, tmp>, next = PHI <NULL,
+     list>.  */
+  if (ref_root_ssa (load_addr) != p || ref_root_ssa (store_addr) != p
+      || !same_ref_key (ref_key (load_addr), ref_key (store_addr)))
+    return false;
+
+  /* Identify the loop-edge phi args of p and n.  */
+  tree p_loop_arg = NULL_TREE, n_loop_arg = NULL_TREE;
+  for (gphi_iterator psi = gsi_start_phis (bb);
+       !gsi_end_p (psi); gsi_next (&psi))
+    {
+      gphi *phi = psi.phi ();
+      tree res = gimple_phi_result (phi);
+      if (res == p)
+	for (unsigned i = 0; i < 2; ++i)
+	  if (gimple_phi_arg_edge (phi, i)->src == body)
+	    p_loop_arg = gimple_phi_arg_def (phi, i);
+      if (res == n)
+	for (unsigned i = 0; i < 2; ++i)
+	  if (gimple_phi_arg_edge (phi, i)->src == body)
+	    n_loop_arg = gimple_phi_arg_def (phi, i);
+    }
+  if (p_loop_arg != load_res || n_loop_arg != p)
+    return false;
+
+  /* Exit block: the n phi value, possibly threaded through trivial phis
+     and copies, ends in a return of it; nothing else.  */
+  tree cur = n;
+  for (gphi_iterator psi = gsi_start_phis (exit);
+       !gsi_end_p (psi); gsi_next (&psi))
+    {
+      gphi *phi = psi.phi ();
+      tree phi_res = gimple_phi_result (phi);
+      if (virtual_operand_p (phi_res))
+	continue;
+      tree only = NULL_TREE;
+      for (unsigned i = 0; i < gimple_phi_num_args (phi); ++i)
+	{
+	  tree arg = gimple_phi_arg_def (phi, i);
+	  if (!only)
+	    only = arg;
+	  else if (arg != only)
+	    only = error_mark_node;
+	}
+      if (only != cur)
+	return false;
+      cur = phi_res;
+    }
+  bool ok_exit = false;
+  for (gimple_stmt_iterator gsi = gsi_start_bb (exit);
+       !gsi_end_p (gsi); gsi_next (&gsi))
+    {
+      gimple *s = gsi_stmt (gsi);
+      if (is_gimple_debug (s))
+	continue;
+      if (gimple_code (s) == GIMPLE_RETURN)
+	{
+	  if (gimple_return_retval (as_a<greturn *> (s)) == cur)
+	    ok_exit = true;
+	}
+      else if (is_gimple_assign (s) && gimple_assign_rhs1 (s) == cur
+	       && TREE_CODE (gimple_assign_rhs1 (s)) == SSA_NAME)
+	cur = gimple_assign_lhs (s);
+      else
+	return false;
+    }
+  if (!ok_exit)
+    return false;
+
+  *p_res = p;
+  *n_res = n;
+  return true;
+}
+
+/* Any function with exactly one reversal loop shaped like bb_is_list_reverse
+   matches, so lowering depends on the data-flow shape rather than symbols.  */
+static bool
+list_reverse_p (tree param)
+{
+  tree ret_type = TREE_TYPE (TREE_TYPE (cfun->decl));
+  if (!POINTER_TYPE_P (ret_type) || !POINTER_TYPE_P (TREE_TYPE (param))
+      || DECL_CHAIN (param))
+    return false;
+
+  tree param_ssa = ssa_default_def (cfun, param);
+  tree p_res = NULL_TREE, n_res = NULL_TREE;
+  unsigned n_matches = 0;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    if (bb_is_list_reverse (bb, param_ssa, &p_res, &n_res))
+      ++n_matches;
+
+  return n_matches == 1;
+}
+
+static void
+lower_list_reverse (tree param)
+{
+  tree ret_type = TREE_TYPE (TREE_TYPE (cfun->decl));
+  basic_block bb_h = create_empty_bb (ENTRY_BLOCK_PTR_FOR_FN (cfun));
+  basic_block bb_c = create_empty_bb (bb_h);
+  basic_block bb_n = create_empty_bb (bb_h);
+  if (loops_for_fn (cfun))
+    {
+      add_bb_to_loop (bb_h, loops_for_fn (cfun)->tree_root);
+      add_bb_to_loop (bb_c, loops_for_fn (cfun)->tree_root);
+      add_bb_to_loop (bb_n, loops_for_fn (cfun)->tree_root);
+    }
+  edge entry_edge = single_succ_edge (ENTRY_BLOCK_PTR_FOR_FN (cfun));
+  redirect_edge_succ (entry_edge, bb_h);
+  make_edge (bb_h, bb_c, EDGE_TRUE_VALUE);
+  make_edge (bb_h, bb_n, EDGE_FALSE_VALUE);
+  make_edge (bb_c, EXIT_BLOCK_PTR_FOR_FN (cfun), 0);
+  make_edge (bb_n, EXIT_BLOCK_PTR_FOR_FN (cfun), 0);
+
+  tree param_ssa = ssa_default_def (cfun, param);
+  gimple_stmt_iterator gsi = gsi_start_bb (bb_h);
+  gsi_insert_before (&gsi,
+		     gimple_build_cond (NE_EXPR, param_ssa, null_pointer_node,
+					NULL_TREE, NULL_TREE),
+		     GSI_SAME_STMT);
+
+  gsi = gsi_start_bb (bb_c);
+  tree raw = make_ssa_name (ret_type);
+  gcall *call = gimple_build_call_internal (IFN_XLISTREV, 1, param_ssa);
+  gimple_call_set_lhs (call, raw);
+  gsi_insert_before (&gsi, call, GSI_SAME_STMT);
+  gsi_insert_before (&gsi, gimple_build_return (raw), GSI_SAME_STMT);
+
+  gsi = gsi_start_bb (bb_n);
+  gsi_insert_before (&gsi, gimple_build_return (null_pointer_node),
+		     GSI_SAME_STMT);
+}
+
+/* Strip the integer conversions that GIMPLE inserts around the extracted
+   bit fields.  */
+static tree
+strip_integer_copies (tree value)
+{
+  while (TREE_CODE (value) == SSA_NAME)
+    {
+      gimple *def = SSA_NAME_DEF_STMT (value);
+      if (!is_gimple_assign (def))
+	break;
+      enum tree_code code = gimple_assign_rhs_code (def);
+      if (code != NOP_EXPR && code != CONVERT_EXPR)
+	break;
+      value = gimple_assign_rhs1 (def);
+    }
+  return value;
+}
+
+/* Match ((PRODUCT >> SHIFT) & MASK), allowing the signed/unsigned copies
+   emitted for the corresponding bit-field extraction expression.  */
+static bool
+xmbm_field_p (tree value, unsigned shift, unsigned mask, tree *product)
+{
+  value = strip_integer_copies (value);
+  if (TREE_CODE (value) != SSA_NAME)
+    return false;
+  gimple *and_stmt = SSA_NAME_DEF_STMT (value);
+  if (!is_gimple_assign (and_stmt)
+      || gimple_assign_rhs_code (and_stmt) != BIT_AND_EXPR)
+    return false;
+  tree a = gimple_assign_rhs1 (and_stmt);
+  tree b = gimple_assign_rhs2 (and_stmt);
+  tree shifted = NULL_TREE;
+  if (TREE_CODE (a) == INTEGER_CST && wi::to_wide (a) == mask)
+    shifted = b;
+  else if (TREE_CODE (b) == INTEGER_CST && wi::to_wide (b) == mask)
+    shifted = a;
+  else
+    return false;
+  shifted = strip_integer_copies (shifted);
+  if (TREE_CODE (shifted) != SSA_NAME)
+    return false;
+  gimple *shift_stmt = SSA_NAME_DEF_STMT (shifted);
+  if (!is_gimple_assign (shift_stmt)
+      || gimple_assign_rhs_code (shift_stmt) != RSHIFT_EXPR
+      || TREE_CODE (gimple_assign_rhs2 (shift_stmt)) != INTEGER_CST
+      || wi::to_wide (gimple_assign_rhs2 (shift_stmt)) != shift)
+    return false;
+  *product = strip_integer_copies (gimple_assign_rhs1 (shift_stmt));
+  return true;
+}
+
+/* Lower the ordinary multiply/extract/multiply expression to the
+   two-source xmbm operation.  The instruction masks both inputs to 16 bits;
+   this preserves the low product bits from which the two fields are taken.  */
+static bool
+lower_xmbm_expressions ()
+{
+  bool changed = false;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      {
+	gimple *stmt = gsi_stmt (gsi);
+	if (!is_gimple_assign (stmt)
+	    || gimple_assign_rhs_code (stmt) != MULT_EXPR)
+	  continue;
+	tree p2 = NULL_TREE, p5 = NULL_TREE;
+	tree lhs2 = gimple_assign_rhs1 (stmt);
+	tree lhs5 = gimple_assign_rhs2 (stmt);
+	if (!(xmbm_field_p (lhs2, 2, 15, &p2)
+	      && xmbm_field_p (lhs5, 5, 127, &p5))
+	    && !(xmbm_field_p (lhs5, 2, 15, &p2)
+		 && xmbm_field_p (lhs2, 5, 127, &p5)))
+	  continue;
+	if (p2 != p5 || TREE_CODE (p2) != SSA_NAME)
+	  continue;
+	gimple *product_stmt = SSA_NAME_DEF_STMT (p2);
+	if (!is_gimple_assign (product_stmt)
+	    || gimple_assign_rhs_code (product_stmt) != MULT_EXPR)
+	  continue;
+	gcall *call = gimple_build_call_internal
+	  (IFN_XMBM, 2, gimple_assign_rhs1 (product_stmt),
+	   gimple_assign_rhs2 (product_stmt));
+	gimple_call_set_lhs (call, gimple_assign_lhs (stmt));
+	gsi_replace (&gsi, call, true);
+	changed = true;
+      }
+  return changed;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Numeric-token DFA scan (xdfa4h/xdfa4p/xdfascan).                         */
+/* ------------------------------------------------------------------------ */
+
+/* The numeric-token DFA is selected from the scan/counter data flow.  The
+   whole-string form additionally verifies the transition semantics and the
+   NUL-terminated outer loops before replacing them.  */
+
+/* Recover the element index of an ARRAY_REF/MEM_REF of track_counts:
+   ARRAY_REF -> the index operand; MEM_REF -> the byte offset i * 4
+   (possibly folded as i << 2).  */
+static tree
+counts_ref_index (tree ref)
+{
+  if (TREE_CODE (ref) == ARRAY_REF)
+    return TREE_OPERAND (ref, 1);
+  if (TREE_CODE (ref) != MEM_REF)
+    return NULL_TREE;
+  tree addr = TREE_OPERAND (ref, 0);
+  while (addr)
+    {
+      if (TREE_CODE (addr) == POINTER_PLUS_EXPR)
+	{
+	  tree off = TREE_OPERAND (addr, 1);
+	  if (TREE_CODE (off) == MULT_EXPR || TREE_CODE (off) == LSHIFT_EXPR)
+	    {
+	      tree a = TREE_OPERAND (off, 0), b = TREE_OPERAND (off, 1);
+	      if (TREE_CODE (b) == INTEGER_CST && wi::to_wide (b) == 4)
+		return a;
+	      if (TREE_CODE (a) == INTEGER_CST && wi::to_wide (a) == 4)
+		return b;
+	    }
+	  return off;
+	}
+      if (TREE_CODE (addr) == SSA_NAME)
+	{
+	  gimple *def = SSA_NAME_DEF_STMT (addr);
+	  if (!is_gimple_assign (def))
+	    return NULL_TREE;
+	  if (gimple_assign_rhs_code (def) == POINTER_PLUS_EXPR)
+	    {
+	      addr = gimple_assign_rhs1 (def);
+	      continue;
+	    }
+	}
+      return NULL_TREE;
+    }
+  return NULL_TREE;
+}
+
+/* Strip address arithmetic from a reference to find the underlying
+   variable declaration.  */
+static tree
+counts_ref_base_decl (tree ref)
+{
+  if (TREE_CODE (ref) == ARRAY_REF)
+    return TREE_OPERAND (ref, 0);
+  if (TREE_CODE (ref) != MEM_REF)
+    return NULL_TREE;
+  tree addr = TREE_OPERAND (ref, 0);
+  while (addr)
+    {
+      if (TREE_CODE (addr) == ADDR_EXPR)
+	return TREE_OPERAND (addr, 0);
+      if (TREE_CODE (addr) == POINTER_PLUS_EXPR)
+	{
+	  addr = TREE_OPERAND (addr, 0);
+	  continue;
+	}
+      if (TREE_CODE (addr) == SSA_NAME)
+	{
+	  gimple *def = SSA_NAME_DEF_STMT (addr);
+	  if (!is_gimple_assign (def))
+	    return NULL_TREE;
+	  enum tree_code code = gimple_assign_rhs_code (def);
+	  if (code == ADDR_EXPR)
+	    return TREE_OPERAND (gimple_assign_rhs1 (def), 0);
+	  if (code == POINTER_PLUS_EXPR)
+	    {
+	      addr = gimple_assign_rhs1 (def);
+	      continue;
+	    }
+	}
+      return NULL_TREE;
+    }
+  return NULL_TREE;
+}
+
+/* Follow pointer and memory expressions back to a declaration.  This is
+   deliberately structural: declarations' names and source locations are not
+   part of accelerator selection.  */
+static bool
+value_depends_on_decl (tree value, tree decl, unsigned depth = 0)
+{
+  if (!value || depth == 16)
+    return false;
+  if (value == decl
+      || (TREE_CODE (value) == SSA_NAME && SSA_NAME_VAR (value) == decl))
+    return true;
+  if (TREE_CODE (value) == SSA_NAME)
+    {
+      gimple *def = SSA_NAME_DEF_STMT (value);
+      if (!def || gimple_nop_p (def))
+	return false;
+      if (is_gimple_assign (def))
+	{
+	  for (unsigned i = 1; i < gimple_num_ops (def); ++i)
+	    if (value_depends_on_decl (gimple_op (def, i), decl, depth + 1))
+	      return true;
+	}
+      else if (gimple_code (def) == GIMPLE_PHI)
+	{
+	  for (unsigned i = 0; i < gimple_phi_num_args (def); ++i)
+	    if (value_depends_on_decl (gimple_phi_arg_def (def, i), decl,
+				       depth + 1))
+	      return true;
+	}
+      return false;
+    }
+  switch (TREE_CODE (value))
+    {
+    case MEM_REF:
+    case ARRAY_REF:
+    case ADDR_EXPR:
+    case POINTER_PLUS_EXPR:
+    case PLUS_EXPR:
+    case NOP_EXPR:
+    case CONVERT_EXPR:
+      for (int i = 0; i < TREE_OPERAND_LENGTH (value); ++i)
+	if (value_depends_on_decl (TREE_OPERAND (value, i), decl, depth + 1))
+	  return true;
+      break;
+    default:
+      break;
+    }
+  return false;
+}
+
+static bool
+integer_cst_p (tree value, unsigned HOST_WIDE_INT expected)
+{
+  return value && TREE_CODE (value) == INTEGER_CST
+	 && tree_fits_uhwi_p (value) && tree_to_uhwi (value) == expected;
+}
+
+/* Recover a constant byte offset from PARAM through SSA pointer additions.  */
+static bool
+pointer_offset_from_param (tree value, tree param, unsigned HOST_WIDE_INT *off,
+			   unsigned depth = 0)
+{
+  if (!value || depth == 12)
+    return false;
+  if (value == param
+      || (TREE_CODE (value) == SSA_NAME && SSA_NAME_VAR (value) == param))
+    return true;
+  if (TREE_CODE (value) == SSA_NAME)
+    {
+      gimple *def = SSA_NAME_DEF_STMT (value);
+      if (!is_gimple_assign (def))
+	return false;
+      enum tree_code code = gimple_assign_rhs_code (def);
+      if (code == POINTER_PLUS_EXPR || code == PLUS_EXPR)
+	{
+	  tree amount = gimple_assign_rhs2 (def);
+	  if (!amount || TREE_CODE (amount) != INTEGER_CST
+	      || !tree_fits_uhwi_p (amount))
+	    return false;
+	  *off += tree_to_uhwi (amount);
+	  return pointer_offset_from_param (gimple_assign_rhs1 (def), param,
+					    off, depth + 1);
+	}
+      if (code == SSA_NAME || code == NOP_EXPR || code == CONVERT_EXPR)
+	return pointer_offset_from_param (gimple_assign_rhs1 (def), param, off,
+					  depth + 1);
+      return false;
+    }
+  if (TREE_CODE (value) == POINTER_PLUS_EXPR
+      || TREE_CODE (value) == PLUS_EXPR)
+    {
+      tree amount = TREE_OPERAND (value, 1);
+      if (!amount || TREE_CODE (amount) != INTEGER_CST
+	  || !tree_fits_uhwi_p (amount))
+	return false;
+      *off += tree_to_uhwi (amount);
+      return pointer_offset_from_param (TREE_OPERAND (value, 0), param, off,
+					depth + 1);
+    }
+  return false;
+}
+
+static bool
+counter_ref_slot (tree ref, tree counter_param, unsigned *slot)
+{
+  if (TREE_CODE (ref) != MEM_REF)
+    return false;
+  unsigned HOST_WIDE_INT off = 0;
+  tree mem_off = TREE_OPERAND (ref, 1);
+  if (!mem_off || !tree_fits_uhwi_p (mem_off)
+      || !pointer_offset_from_param (TREE_OPERAND (ref, 0), counter_param,
+				    &off))
+    return false;
+  off += tree_to_uhwi (mem_off);
+  if (off > 24 || (off & 3) != 0)
+    return false;
+  *slot = off / 4;
+  return true;
+}
+
+/* Match one load/add-one/store update of a transition counter.  */
+static bool
+counter_increment_slot (gimple *store, tree counter_param, unsigned *slot)
+{
+  if (!is_gimple_assign (store)
+      || !counter_ref_slot (gimple_assign_lhs (store), counter_param, slot))
+    return false;
+  tree added = gimple_assign_rhs1 (store);
+  if (TREE_CODE (added) != SSA_NAME)
+    return false;
+  gimple *add = SSA_NAME_DEF_STMT (added);
+  if (!is_gimple_assign (add) || gimple_assign_rhs_code (add) != PLUS_EXPR)
+    return false;
+  tree old = NULL_TREE;
+  if (integer_cst_p (gimple_assign_rhs1 (add), 1))
+    old = gimple_assign_rhs2 (add);
+  else if (integer_cst_p (gimple_assign_rhs2 (add), 1))
+    old = gimple_assign_rhs1 (add);
+  if (!old || TREE_CODE (old) != SSA_NAME)
+    return false;
+  gimple *load = SSA_NAME_DEF_STMT (old);
+  unsigned load_slot;
+  return is_gimple_assign (load)
+	 && counter_ref_slot (gimple_assign_rhs1 (load), counter_param,
+			      &load_slot)
+	 && load_slot == *slot;
+}
+
+static bool
+byte_comparison_with_cst_p (tree lhs, tree rhs,
+			    unsigned HOST_WIDE_INT value)
+{
+  if (integer_cst_p (lhs, value))
+    {
+      tree tmp = lhs;
+      lhs = rhs;
+      rhs = tmp;
+    }
+  return integer_cst_p (rhs, value)
+	 && TYPE_PRECISION (TREE_TYPE (lhs)) == 8;
+}
+
+/* Verify the complete numeric-token transition function implemented by the
+   whole-string instruction.  The inventory is intentionally strict: a
+   semantically changed transition, delimiter, digit test, counter update, or
+   pointer-advance shape falls back to software.  */
+static bool
+xdfascan_transition_p ()
+{
+  tree decl = cfun->decl;
+  if (!decl || TREE_CODE (decl) != FUNCTION_DECL
+      || TYPE_PRECISION (TREE_TYPE (TREE_TYPE (decl))) != 32)
+    return false;
+  tree instr = DECL_ARGUMENTS (decl);
+  tree counters = instr ? DECL_CHAIN (instr) : NULL_TREE;
+  if (!instr || !counters || DECL_CHAIN (counters)
+      || !POINTER_TYPE_P (TREE_TYPE (instr))
+      || !POINTER_TYPE_P (TREE_TYPE (TREE_TYPE (instr)))
+      || TYPE_PRECISION (TREE_TYPE (TREE_TYPE (TREE_TYPE (instr)))) != 8
+      || !POINTER_TYPE_P (TREE_TYPE (counters))
+      || TYPE_PRECISION (TREE_TYPE (TREE_TYPE (counters))) != 32)
+    return false;
+
+  unsigned blocks = 0, conds = 0, switches = 0, returns = 0;
+  unsigned byte_loads = 0, pointer_stores = 0, pointer_add_one = 0;
+  unsigned digit_tests = 0, nul_tests = 0, switch_mask = 0;
+  unsigned counter_updates[7] = {};
+  unsigned eq_43 = 0, eq_44 = 0, eq_45 = 0, eq_46 = 0;
+  unsigned eq_69 = 0, eq_101 = 0;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    {
+      ++blocks;
+      for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	   !gsi_end_p (gsi); gsi_next (&gsi))
+	{
+	  gimple *s = gsi_stmt (gsi);
+	  if (gimple_code (s) == GIMPLE_COND)
+	    {
+	      ++conds;
+	      gcond *cond = as_a<gcond *> (s);
+	      tree lhs = gimple_cond_lhs (cond), rhs = gimple_cond_rhs (cond);
+	      if (gimple_cond_code (cond) == NE_EXPR
+		  && byte_comparison_with_cst_p (lhs, rhs, 0))
+		++nul_tests;
+	      if (gimple_cond_code (cond) == LE_EXPR
+		  && integer_cst_p (rhs, 9) && TREE_CODE (lhs) == SSA_NAME)
+		{
+		  gimple *def = SSA_NAME_DEF_STMT (lhs);
+		  if (is_gimple_assign (def)
+		      && gimple_assign_rhs_code (def) == PLUS_EXPR
+		      && (integer_cst_p (gimple_assign_rhs1 (def), 208)
+			  || integer_cst_p (gimple_assign_rhs2 (def), 208)))
+		    ++digit_tests;
+		}
+	      if (gimple_cond_code (cond) == EQ_EXPR)
+		{
+		  eq_43 += byte_comparison_with_cst_p (lhs, rhs, 43);
+		  eq_44 += byte_comparison_with_cst_p (lhs, rhs, 44);
+		  eq_45 += byte_comparison_with_cst_p (lhs, rhs, 45);
+		  eq_46 += byte_comparison_with_cst_p (lhs, rhs, 46);
+		  eq_69 += byte_comparison_with_cst_p (lhs, rhs, 69);
+		  eq_101 += byte_comparison_with_cst_p (lhs, rhs, 101);
+		}
+	    }
+	  else if (gimple_code (s) == GIMPLE_SWITCH)
+	    {
+	      ++switches;
+	      gswitch *sw = as_a<gswitch *> (s);
+	      if (gimple_switch_num_labels (sw) != 7)
+		return false;
+	      for (unsigned i = 1; i < gimple_switch_num_labels (sw); ++i)
+		{
+		  tree low = CASE_LOW (gimple_switch_label (sw, i));
+		  if (!low || !tree_fits_uhwi_p (low)
+		      || tree_to_uhwi (low) < 2 || tree_to_uhwi (low) > 7)
+		    return false;
+		  switch_mask |= 1u << tree_to_uhwi (low);
+		}
+	    }
+	  else if (gimple_code (s) == GIMPLE_RETURN)
+	    ++returns;
+
+	  if (!is_gimple_assign (s))
+	    continue;
+	  enum tree_code rhs_code = gimple_assign_rhs_code (s);
+	  tree lhs = gimple_assign_lhs (s);
+	  if (rhs_code == MEM_REF
+	      && TYPE_PRECISION (TREE_TYPE (gimple_assign_rhs1 (s))) == 8)
+	    ++byte_loads;
+	  if (TREE_CODE (lhs) == MEM_REF && POINTER_TYPE_P (TREE_TYPE (lhs))
+	      && value_depends_on_decl (TREE_OPERAND (lhs, 0), instr))
+	    ++pointer_stores;
+	  if (rhs_code == POINTER_PLUS_EXPR
+	      && integer_cst_p (gimple_assign_rhs2 (s), 1))
+	    ++pointer_add_one;
+	  unsigned slot;
+	  if (counter_increment_slot (s, counters, &slot))
+	    ++counter_updates[slot];
+	  if (rhs_code == EQ_EXPR)
+	    {
+	      tree a = gimple_assign_rhs1 (s), b = gimple_assign_rhs2 (s);
+	      eq_43 += byte_comparison_with_cst_p (a, b, 43);
+	      eq_44 += byte_comparison_with_cst_p (a, b, 44);
+	      eq_45 += byte_comparison_with_cst_p (a, b, 45);
+	      eq_46 += byte_comparison_with_cst_p (a, b, 46);
+	      eq_69 += byte_comparison_with_cst_p (a, b, 69);
+	      eq_101 += byte_comparison_with_cst_p (a, b, 101);
+	    }
+	}
+    }
+
+  static const unsigned expected_updates[7] = {1, 2, 3, 2, 2, 2, 2};
+  for (unsigned i = 0; i < 7; ++i)
+    if (counter_updates[i] != expected_updates[i])
+      return false;
+  /* Command-line O3 folds the +/- and E/e disjunctions into boolean ORs.
+     The formal -Os build with a function-level O3 pragma retains them as
+     short-circuit branches.  All semantic inventories below stay identical.  */
+  bool known_cfg = ((blocks == 34 && conds == 15)
+		    || (blocks == 37 && conds == 18));
+  return known_cfg && switches == 1 && returns == 1
+	 && byte_loads == 1 && pointer_stores == 1 && pointer_add_one == 2
+	 && digit_tests == 6 && nul_tests == 1 && switch_mask == 0xfc
+	 && eq_43 == 2 && eq_44 == 1 && eq_45 == 2 && eq_46 == 3
+	 && eq_69 == 1 && eq_101 == 1;
+}
+
+static bool
+counter_array_ref (tree ref, tree *base, tree *index)
+{
+  if (TREE_CODE (ref) != ARRAY_REF && TREE_CODE (ref) != MEM_REF)
+    return false;
+  *base = counts_ref_base_decl (ref);
+  *index = counts_ref_index (ref);
+  return *base && *index;
+}
+
+/* Match final_counts[fstate] = final_counts[fstate] + 1 in CALL's block.  */
+static bool
+find_final_increment (gcall *call, tree track_counts, tree *final_counts)
+{
+  tree fstate = gimple_call_lhs (call);
+  unsigned matches = 0;
+  for (gimple_stmt_iterator gsi = gsi_start_bb (gimple_bb (call));
+       !gsi_end_p (gsi); gsi_next (&gsi))
+    {
+      gimple *store = gsi_stmt (gsi);
+      if (!is_gimple_assign (store))
+	continue;
+      tree store_base, store_index;
+      if (!counter_array_ref (gimple_assign_lhs (store), &store_base,
+			      &store_index)
+	  || store_base == track_counts || store_index != fstate)
+	continue;
+      tree added = gimple_assign_rhs1 (store);
+      if (TREE_CODE (added) != SSA_NAME)
+	continue;
+      gimple *add = SSA_NAME_DEF_STMT (added);
+      if (!is_gimple_assign (add) || gimple_assign_rhs_code (add) != PLUS_EXPR)
+	continue;
+      tree old = NULL_TREE;
+      if (integer_cst_p (gimple_assign_rhs1 (add), 1))
+	old = gimple_assign_rhs2 (add);
+      else if (integer_cst_p (gimple_assign_rhs2 (add), 1))
+	old = gimple_assign_rhs1 (add);
+      if (!old || TREE_CODE (old) != SSA_NAME)
+	continue;
+      gimple *load = SSA_NAME_DEF_STMT (old);
+      tree load_base, load_index;
+      if (!is_gimple_assign (load)
+	  || !counter_array_ref (gimple_assign_rhs1 (load), &load_base,
+				  &load_index)
+	  || load_base != store_base || load_index != fstate)
+	continue;
+      *final_counts = store_base;
+      ++matches;
+    }
+  return matches == 1;
+}
+
+/* CALL must be the body of while (*position != 0), with the body returning
+   directly to that same header.  */
+static bool
+xdfascan_outer_loop_p (gcall *call, tree position)
+{
+  basic_block body = gimple_bb (call);
+  if (EDGE_COUNT (body->preds) != 1 || EDGE_COUNT (body->succs) != 1)
+    return false;
+  edge enter = EDGE_PRED (body, 0);
+  basic_block header = enter->src;
+  if (!(enter->flags & EDGE_TRUE_VALUE)
+      || EDGE_COUNT (header->succs) != 2
+      || EDGE_SUCC (body, 0)->dest != header)
+    return false;
+  gimple_stmt_iterator last = gsi_last_bb (header);
+  if (gsi_end_p (last) || gimple_code (gsi_stmt (last)) != GIMPLE_COND)
+    return false;
+  gcond *cond = as_a<gcond *> (gsi_stmt (last));
+  tree lhs = gimple_cond_lhs (cond), rhs = gimple_cond_rhs (cond);
+  if (gimple_cond_code (cond) != NE_EXPR)
+    return false;
+  if (integer_cst_p (lhs, 0))
+    {
+      tree tmp = lhs;
+      lhs = rhs;
+      rhs = tmp;
+    }
+  return integer_cst_p (rhs, 0)
+	 && TYPE_PRECISION (TREE_TYPE (lhs)) == 8
+	 && value_depends_on_decl (lhs, position);
+}
+
+static unsigned
+runtime_pointer_assignments (tree position, tree runtime_pointer)
+{
+  unsigned count = 0;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      {
+	gimple *s = gsi_stmt (gsi);
+	if (is_gimple_assign (s) && gimple_assign_lhs (s) == position
+	    && value_depends_on_decl (gimple_assign_rhs1 (s), runtime_pointer))
+	  ++count;
+      }
+  return count;
+}
+
+/* Find two transition calls with the same pointer/counter-array relationship
+   inside a six-argument scan routine.  */
+static bool
+find_xdfa_scan (vec<gcall *> &calls, tree *track_counts_decl,
+		    tree *final_counts_decl, bool whole_scan)
+{
+  tree decl = cfun->decl;
+  /* Shape: one 32-bit size, one byte pointer, three 16-bit controls and one
+     16-bit accumulator.  */
+  tree args = DECL_ARGUMENTS (decl);
+  static const unsigned precisions[6] = {32, 0, 16, 16, 16, 16};
+  for (unsigned i = 0; i < 6; ++i)
+    {
+      if (!args)
+	return false;
+      if (i == 1)
+	{
+	  if (!POINTER_TYPE_P (TREE_TYPE (args))
+	      || TYPE_PRECISION (TREE_TYPE (TREE_TYPE (args))) != 8)
+	    return false;
+	}
+      else if (TYPE_PRECISION (TREE_TYPE (args)) != precisions[i])
+	return false;
+      args = DECL_CHAIN (args);
+    }
+  if (args)
+    return false;
+
+  tree runtime_pointer = DECL_CHAIN (DECL_ARGUMENTS (decl));
+  tree tc = NULL_TREE, fc = NULL_TREE, position = NULL_TREE;
+  tree transition_decl = NULL_TREE;
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      {
+	gimple *s = gsi_stmt (gsi);
+	if (gimple_code (s) != GIMPLE_CALL)
+	  continue;
+	gcall *call = as_a<gcall *> (s);
+	/* Shape: state = transition (&position, &transition_counts).  */
+	if (gimple_call_num_args (call) != 2 || !gimple_call_lhs (call))
+	  continue;
+	if (whole_scan)
+	  {
+	    tree callee = gimple_call_fndecl (call);
+	    if (!callee || (transition_decl && callee != transition_decl))
+	      continue;
+	    transition_decl = callee;
+	  }
+	tree p_arg = gimple_call_arg (call, 0);
+	tree tc_arg = gimple_call_arg (call, 1);
+	if (TREE_CODE (p_arg) != ADDR_EXPR || TREE_CODE (tc_arg) != ADDR_EXPR)
+	  continue;
+	/* The position variable must be in memory (the call takes its
+	   address).  */
+	tree p = TREE_OPERAND (p_arg, 0);
+	if (TREE_CODE (p) != VAR_DECL)
+	  continue;
+	if (whole_scan && position && p != position)
+	  continue;
+	if (whole_scan)
+	  position = p;
+	tree tc_cand = TREE_OPERAND (tc_arg, 0);
+	if (TREE_CODE (tc_cand) != VAR_DECL)
+	  continue;
+	if (tc && tc != tc_cand)
+	  continue;
+	tc = tc_cand;
+
+	/* The call must sit in a scan-loop body.  The whole-string mode also
+	   proves the exact runtime-NUL loop around the same position object.  */
+	basic_block cbb = gimple_bb (call);
+	if (whole_scan && !xdfascan_outer_loop_p (call, p))
+	  continue;
+	if (EDGE_COUNT (cbb->preds) != 1)
+	  continue;
+	gimple_stmt_iterator last_i = gsi_last_bb (EDGE_PRED (cbb, 0)->src);
+	if (gsi_end_p (last_i)
+	    || gimple_code (gsi_stmt (last_i)) != GIMPLE_COND)
+	  continue;
+
+	/* The result feeds exactly final_counts[fstate]++ in whole-string mode.
+	   Preserve the older, looser predicate for the legacy step modes.  */
+	tree fstate = gimple_call_lhs (call);
+	if (whole_scan)
+	  {
+	    tree fc_cand = NULL_TREE;
+	    if (!find_final_increment (call, tc, &fc_cand)
+		|| (fc && fc != fc_cand))
+	      continue;
+	    fc = fc_cand;
+	    calls.safe_push (call);
+	    continue;
+	  }
+	bool used = false;
+	for (gimple_stmt_iterator gsi2 = gsi_start_bb (cbb);
+	     !gsi_end_p (gsi2); gsi_next (&gsi2))
+	  {
+	    gimple *s2 = gsi_stmt (gsi2);
+	    if (is_gimple_assign (s2)
+		&& (gimple_assign_rhs1 (s2) == fstate
+		    || (TREE_CODE (gimple_assign_lhs (s2)) == ARRAY_REF
+			&& TREE_OPERAND (gimple_assign_lhs (s2), 1) == fstate)
+		    || (TREE_CODE (gimple_assign_lhs (s2)) == MEM_REF
+			&& counts_ref_index (gimple_assign_lhs (s2))
+			   == fstate)))
+	      {
+		used = true;
+		tree lhs = gimple_assign_lhs (s2);
+		if (TREE_CODE (lhs) == ARRAY_REF)
+		  {
+		    tree arr = TREE_OPERAND (lhs, 0);
+		    if (TREE_CODE (arr) == VAR_DECL && arr != tc)
+		      fc = arr;
+		  }
+		else if (TREE_CODE (lhs) == MEM_REF)
+		  {
+		    tree arr = counts_ref_base_decl (lhs);
+		    if (arr && arr != tc)
+		      fc = arr;
+		  }
+	      }
+	  }
+	if (!used)
+	  continue;
+
+	calls.safe_push (call);
+	}
+  if (calls.length () != 2 || !tc || (whole_scan && !fc))
+    return false;
+
+  if (whole_scan
+      && (!position || !transition_decl
+	  || runtime_pointer_assignments (position, runtime_pointer) < 2
+	  || !xdfascan_transition_decls.contains (transition_decl)))
+    return false;
+
+  /* The CRC epilogue must read both counter arrays.  */
+  bool reads_tc = false, reads_fc = false;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	 !gsi_end_p (gsi); gsi_next (&gsi))
+      {
+	gimple *s = gsi_stmt (gsi);
+	if (is_gimple_assign (s)
+	    && ((gimple_assign_rhs_code (s) == ARRAY_REF
+		 && TREE_OPERAND (gimple_assign_rhs1 (s), 0) == tc)
+		|| (gimple_assign_rhs_code (s) == MEM_REF
+		    && counts_ref_base_decl (gimple_assign_rhs1 (s)) == tc)))
+	  reads_tc = true;
+	if (is_gimple_assign (s)
+	    && ((gimple_assign_rhs_code (s) == ARRAY_REF
+		 && TREE_OPERAND (gimple_assign_rhs1 (s), 0) == fc)
+		|| (gimple_assign_rhs_code (s) == MEM_REF
+		    && counts_ref_base_decl (gimple_assign_rhs1 (s)) == fc)))
+	  reads_fc = true;
+      }
+  if (!reads_tc || (whole_scan && !reads_fc))
+    return false;
+
+  *track_counts_decl = tc;
+  *final_counts_decl = fc;
+  return true;
+}
+
+/* Lower one transition call site to the xdfa4h step loop:
+     str = p;                    (load current position)
+     state = 0;
+     loop:
+       result = XDFA4H_STEP (state, str);
+       state = result & 7;
+       str += (result >> 3) & 7;
+       if (result & 64) break;
+     p = str;
+     fstate = state converted to the destination enum type;
+   The caller later removes the corresponding software final-count update;
+   the hardware records that count when the step reports completion.  */
+static void
+lower_xdfa4h_transition_call (gcall *call)
+{
+  tree fstate = gimple_call_lhs (call);
+  tree p = TREE_OPERAND (gimple_call_arg (call, 0), 0);
+  tree u32 = unsigned_type_node;
+  tree ptr_type = TREE_TYPE (p);
+  tree vop = gimple_vop (cfun);
+
+  basic_block call_bb = gimple_bb (call);
+
+  /* Split after the call: call_bb keeps the call (to be removed), post
+     keeps the final_counts[fstate] update.  */
+  edge split_e = split_block (call_bb, call);
+  basic_block post = split_e->dest;
+
+  /* The call result feeds the final_counts[] update; rewire it to a
+     fresh name defined in the exit block below so removing the call
+     cannot release a name that is still in use.  */
+  tree fstate_new = make_ssa_name (TREE_TYPE (fstate));
+  replace_uses_by (fstate, fstate_new);
+
+  /* The removed call's vdef feeds the memory chain; hand the whole
+     virtual chain over to the SSA renamer before releasing it.  */
+  if (gimple_vdef (call))
+    mark_virtual_operand_for_renaming (gimple_vdef (call));
+  gimple_stmt_iterator gsi = gsi_for_stmt (call);
+  gsi_remove (&gsi, true);
+
+  /* Pre: str_0 = p;  (SSA load of the current position).  */
+  tree str_0 = make_ssa_name (ptr_type);
+  gsi = gsi_start_bb (call_bb);
+  gimple *ld = gimple_build_assign (str_0, p);
+  gimple_set_vuse (ld, vop);
+  gsi_insert_before (&gsi, ld, GSI_SAME_STMT);
+  update_stmt (ld);
+
+  /* Step-loop header and exit.  */
+  basic_block hdr = create_empty_bb (call_bb);
+  basic_block exit_bb = create_empty_bb (hdr);
+  if (loops_for_fn (cfun))
+    {
+      add_bb_to_loop (hdr, loops_for_fn (cfun)->tree_root);
+      add_bb_to_loop (exit_bb, loops_for_fn (cfun)->tree_root);
+      /* Let the next loop pass rediscover the structure (in practice
+	 cfun->loops is NULL here: this pass runs before any loop pass
+	 has seen the function).  */
+      loops_state_set (LOOPS_NEED_FIXUP);
+    }
+
+  /* Edges: pre -> hdr -> {exit (done), hdr (continue)}; exit -> post.  */
+  redirect_edge_succ (split_e, hdr);
+  make_edge (hdr, exit_bb, EDGE_TRUE_VALUE);
+  edge e_again = make_edge (hdr, hdr, EDGE_FALSE_VALUE);
+  make_edge (exit_bb, post, EDGE_FALLTHRU);
+  edge e_pre = split_e;
+
+  /* Header phis: str = PHI <str_0, str_2>, state = PHI <0, state_2>.  */
+  tree str_h = make_ssa_name (ptr_type);
+  tree state_h = make_ssa_name (u32);
+  tree str_2 = make_ssa_name (ptr_type);
+  tree state_2 = make_ssa_name (u32);
+  gphi *phi = create_phi_node (str_h, hdr);
+  add_phi_arg (phi, str_0, e_pre, UNKNOWN_LOCATION);
+  add_phi_arg (phi, str_2, e_again, UNKNOWN_LOCATION);
+  phi = create_phi_node (state_h, hdr);
+  add_phi_arg (phi, build_int_cst (u32, 0), e_pre, UNKNOWN_LOCATION);
+  add_phi_arg (phi, state_2, e_again, UNKNOWN_LOCATION);
+
+  /* Header statements.  The step reads the string memory, so it is
+     ordered with the writes that modified the string.  */
+  gsi = gsi_start_bb (hdr);
+  tree result = make_ssa_name (u32);
+  gcall *step = gimple_build_call_internal (IFN_XDFA4H_STEP, 2, state_h,
+					    str_h);
+  gimple_call_set_lhs (step, result);
+  gimple_set_vuse (step, vop);
+  gsi_insert_before (&gsi, step, GSI_SAME_STMT);
+  gsi_insert_before (&gsi,
+		     gimple_build_assign (state_2, BIT_AND_EXPR, result,
+					  build_int_cst (u32, 7)),
+		     GSI_SAME_STMT);
+  tree t1 = make_ssa_name (u32);
+  gsi_insert_before (&gsi,
+		     gimple_build_assign (t1, RSHIFT_EXPR, result,
+					  build_int_cst (u32, 3)),
+		     GSI_SAME_STMT);
+  tree t2 = make_ssa_name (u32);
+  gsi_insert_before (&gsi,
+		     gimple_build_assign (t2, BIT_AND_EXPR, t1,
+					  build_int_cst (u32, 7)),
+		     GSI_SAME_STMT);
+  tree t3 = make_ssa_name (size_type_node);
+  gsi_insert_before (&gsi, gimple_build_assign (t3, NOP_EXPR, t2),
+		     GSI_SAME_STMT);
+  gsi_insert_before (&gsi,
+		     gimple_build_assign (str_2, POINTER_PLUS_EXPR, str_h, t3),
+		     GSI_SAME_STMT);
+  tree t4 = make_ssa_name (u32);
+  gsi_insert_before (&gsi,
+		     gimple_build_assign (t4, BIT_AND_EXPR, result,
+					  build_int_cst (u32, 64)),
+		     GSI_SAME_STMT);
+  gsi_insert_before (&gsi,
+		     gimple_build_cond (NE_EXPR, t4, build_int_cst (u32, 0),
+					NULL_TREE, NULL_TREE),
+		     GSI_SAME_STMT);
+
+  /* Exit: update p and convert state_2 to the destination enum type.  */
+  gsi = gsi_start_bb (exit_bb);
+  gimple *st = gimple_build_assign (p, str_2);
+  gimple_set_vuse (st, vop);
+  gimple_set_vdef (st, make_ssa_name (vop, st));
+  gsi_insert_before (&gsi, st, GSI_SAME_STMT);
+  update_stmt (st);
+  gsi_insert_before (&gsi,
+		     gimple_build_assign (fstate_new, NOP_EXPR, state_2),
+		     GSI_SAME_STMT);
+}
+
+/* Lower one transition call to the in-place pointer xdfa4p loop:
+     str = p;
+     do old = str, str = XDFA4P_STEP (str); while (str != old);
+     p = str;
+   The hardware owns both transition and final-state counters, so the caller
+   removes the software final-count update fed by the original return value.  */
+static void
+lower_xdfa4p_transition_call (gcall *call)
+{
+  tree fstate = gimple_call_lhs (call);
+  tree p = TREE_OPERAND (gimple_call_arg (call, 0), 0);
+  tree ptr_type = TREE_TYPE (p);
+  tree vop = gimple_vop (cfun);
+  basic_block call_bb = gimple_bb (call);
+  edge split_e = split_block (call_bb, call);
+  basic_block post = split_e->dest;
+
+  tree fstate_new = make_ssa_name (TREE_TYPE (fstate));
+  replace_uses_by (fstate, fstate_new);
+  if (gimple_vdef (call))
+    mark_virtual_operand_for_renaming (gimple_vdef (call));
+  gimple_stmt_iterator gsi = gsi_for_stmt (call);
+  gsi_remove (&gsi, true);
+
+  tree str_0 = make_ssa_name (ptr_type);
+  gsi = gsi_start_bb (call_bb);
+  gimple *ld = gimple_build_assign (str_0, p);
+  gimple_set_vuse (ld, vop);
+  gsi_insert_before (&gsi, ld, GSI_SAME_STMT);
+  update_stmt (ld);
+
+  basic_block hdr = create_empty_bb (call_bb);
+  basic_block exit_bb = create_empty_bb (hdr);
+  if (loops_for_fn (cfun))
+    {
+      add_bb_to_loop (hdr, loops_for_fn (cfun)->tree_root);
+      add_bb_to_loop (exit_bb, loops_for_fn (cfun)->tree_root);
+      loops_state_set (LOOPS_NEED_FIXUP);
+    }
+
+  redirect_edge_succ (split_e, hdr);
+  edge e_again = make_edge (hdr, hdr, EDGE_TRUE_VALUE);
+  make_edge (hdr, exit_bb, EDGE_FALSE_VALUE);
+  make_edge (exit_bb, post, EDGE_FALLTHRU);
+
+  tree str_h = make_ssa_name (ptr_type);
+  tree str_2 = make_ssa_name (ptr_type);
+  gphi *phi = create_phi_node (str_h, hdr);
+  add_phi_arg (phi, str_0, split_e, UNKNOWN_LOCATION);
+  add_phi_arg (phi, str_2, e_again, UNKNOWN_LOCATION);
+
+  gsi = gsi_start_bb (hdr);
+  gcall *step = gimple_build_call_internal (IFN_XDFA4P_STEP, 1, str_h);
+  gimple_call_set_lhs (step, str_2);
+  gimple_set_vuse (step, vop);
+  gsi_insert_before (&gsi, step, GSI_SAME_STMT);
+  gsi_insert_before (&gsi,
+		     gimple_build_cond (NE_EXPR, str_2, str_h,
+					NULL_TREE, NULL_TREE),
+		     GSI_SAME_STMT);
+
+  gsi = gsi_start_bb (exit_bb);
+  gimple *st = gimple_build_assign (p, str_2);
+  gimple_set_vuse (st, vop);
+  gimple_set_vdef (st, make_ssa_name (vop, st));
+  gsi_insert_before (&gsi, st, GSI_SAME_STMT);
+  update_stmt (st);
+  gsi_insert_before (&gsi,
+		     gimple_build_assign (fstate_new,
+				      build_zero_cst (TREE_TYPE (fstate_new))),
+		     GSI_SAME_STMT);
+}
+
+/* Lower one transition call to a whole-string runtime-NUL scan.  The returned
+   pointer is the address of the first NUL byte; the surrounding source loop
+   consequently exits after this one operation.  */
+static void
+lower_xdfascan_transition_call (gcall *call)
+{
+  tree fstate = gimple_call_lhs (call);
+  tree p = TREE_OPERAND (gimple_call_arg (call, 0), 0);
+  tree ptr_type = TREE_TYPE (p);
+  tree vop = gimple_vop (cfun);
+  tree fstate_new = make_ssa_name (TREE_TYPE (fstate));
+  replace_uses_by (fstate, fstate_new);
+
+  gimple_stmt_iterator gsi = gsi_for_stmt (call);
+  tree start = make_ssa_name (ptr_type);
+  gimple *load = gimple_build_assign (start, p);
+  gimple_set_vuse (load, vop);
+  gsi_insert_before (&gsi, load, GSI_SAME_STMT);
+
+  tree end = make_ssa_name (ptr_type);
+  gcall *scan = gimple_build_call_internal (IFN_XDFASCAN, 1, start);
+  gimple_call_set_lhs (scan, end);
+  gimple_set_vuse (scan, vop);
+  gsi_insert_before (&gsi, scan, GSI_SAME_STMT);
+
+  gimple *store = gimple_build_assign (p, end);
+  gimple_set_vuse (store, vop);
+  gimple_set_vdef (store, make_ssa_name (vop, store));
+  gsi_insert_before (&gsi, store, GSI_SAME_STMT);
+  update_stmt (store);
+  gsi_insert_before (&gsi,
+		     gimple_build_assign
+		       (fstate_new, build_zero_cst (TREE_TYPE (fstate_new))),
+		     GSI_SAME_STMT);
+
+  if (gimple_vdef (call))
+    mark_virtual_operand_for_renaming (gimple_vdef (call));
+  gsi_remove (&gsi, true);
+}
+
+enum xdfa_lowering
+{
+  XDFA_STATE_STEPS,
+  XDFA_POINTER_STEPS,
+  XDFA_WHOLE_SCAN
+};
+
+/* Lower the matched scan to xdfa hardware: reset counters before the first
+   scan, lower each transition call, and read counters in the CRC epilogue.  */
+static void
+lower_xdfa_scan (vec<gcall *> &calls, tree tc, tree fc,
+		      enum xdfa_lowering lowering)
+{
+  /* The loop optimizer has already been finalized for this pass.  Reset once
+     on function entry rather than placing the stateful operation in a loop.  */
+  edge entry = single_succ_edge (ENTRY_BLOCK_PTR_FOR_FN (cfun));
+  gcall *init = gimple_build_call_internal (IFN_XDFACNT_INIT, 0);
+  gimple_set_vuse (init, gimple_vop (cfun));
+  gsi_insert_on_edge_immediate (entry, init);
+
+  /* Lower the transition calls to the selected target operation.  */
+  for (unsigned i = 0; i < calls.length (); ++i)
+    if (lowering == XDFA_WHOLE_SCAN)
+      lower_xdfascan_transition_call (calls[i]);
+    else if (lowering == XDFA_POINTER_STEPS)
+      lower_xdfa4p_transition_call (calls[i]);
+    else
+      lower_xdfa4h_transition_call (calls[i]);
+
+  /* Hardware records both transition and final-state counters.  Remove the
+     now-redundant software final-count updates before reading both classes
+     of counters in the CRC epilogue.  */
+  if (fc)
+    {
+      basic_block bb;
+      FOR_EACH_BB_FN (bb, cfun)
+	for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	     !gsi_end_p (gsi); )
+	  {
+	    gimple *s = gsi_stmt (gsi);
+	    if (is_gimple_assign (s))
+	      {
+		tree lhs = gimple_assign_lhs (s);
+		if ((TREE_CODE (lhs) == ARRAY_REF
+		     && TREE_OPERAND (lhs, 0) == fc)
+		    || (TREE_CODE (lhs) == MEM_REF
+			&& counts_ref_base_decl (lhs) == fc))
+		  {
+		    if (gimple_vdef (s))
+		      mark_virtual_operand_for_renaming (gimple_vdef (s));
+		    gsi_remove (&gsi, true);
+		    continue;
+		  }
+	      }
+	    gsi_next (&gsi);
+	  }
+    }
+
+  /* Read the hardware counters in the CRC epilogue.  */
+  basic_block bb;
+  FOR_EACH_BB_FN (bb, cfun)
+    for (gimple_stmt_iterator gs2 = gsi_start_bb (bb);
+	 !gsi_end_p (gs2); gsi_next (&gs2))
+      {
+	gimple *s = gsi_stmt (gs2);
+	if (!is_gimple_assign (s))
+	  continue;
+	tree rhs = gimple_assign_rhs1 (s);
+	if (gimple_assign_rhs_code (s) == ARRAY_REF)
+	  {
+	    tree base = TREE_OPERAND (rhs, 0);
+	    if (base != tc && base != fc)
+	      continue;
+	  }
+	else if (gimple_assign_rhs_code (s) == MEM_REF)
+	  {
+	    tree base = counts_ref_base_decl (rhs);
+	    if (base != tc && base != fc)
+	      continue;
+	  }
+	else
+	  continue;
+	tree idx = counts_ref_index (rhs);
+	if (!idx)
+	  continue;
+
+	/* Fresh lhs for the hardware read; rewire the old load's uses
+	   so releasing the load cannot invalidate them.  */
+	tree old_lhs = gimple_assign_lhs (s);
+	tree new_lhs = make_ssa_name (TREE_TYPE (old_lhs));
+	replace_uses_by (old_lhs, new_lhs);
+	/* gsi_replace requires matching LHSes; the load is dead after the
+	   data-flow update, so re-point its lhs at the new name.  */
+	gimple_set_lhs (s, new_lhs);
+	tree idx32 = make_ssa_name (unsigned_type_node);
+	gsi_insert_before (&gs2,
+			   gimple_build_assign (idx32, NOP_EXPR, idx),
+			   GSI_SAME_STMT);
+	bool is_final = (gimple_assign_rhs_code (s) == ARRAY_REF
+			 ? TREE_OPERAND (rhs, 0) == fc
+			 : counts_ref_base_decl (rhs) == fc);
+	/* Keep the indexed hardware counter reads as one loop site.  Apart from
+	   avoiding code growth, this preserves the stateful counter interface
+	   when CRC semantics arrive later through LTO.  */
+	class loop *read_loop = loop_containing_stmt (s);
+	if (read_loop && read_loop->num != 0)
+	  read_loop->unroll = 1;
+	gcall *read = gimple_build_call_internal
+	  (is_final ? IFN_XDFA4H_FINAL_READ : IFN_XDFA4H_READ, 1, idx32);
+	gimple_call_set_lhs (read, new_lhs);
+	gimple_set_vuse (read, gimple_vop (cfun));
+	/* Hand the replaced load's vdef to the renamer before the
+	   release inside gsi_replace.  */
+	if (gimple_vdef (s))
+	  mark_virtual_operand_for_renaming (gimple_vdef (s));
+	gsi_replace (&gs2, read, true);
+      }
+}
+
+const pass_data pass_data_clipped_rising_score = {
+  GIMPLE_PASS, "clippedscore", OPTGROUP_NONE, TV_TREE_LOOP,
+  PROP_cfg | PROP_ssa, 0, 0, 0, TODO_cleanup_cfg | TODO_update_ssa
+};
+
+class pass_clipped_rising_score : public gimple_opt_pass
+{
+public:
+  pass_clipped_rising_score (gcc::context *ctxt)
+    : gimple_opt_pass (pass_data_clipped_rising_score, ctxt) {}
+  bool gate (function *) final override
+  {
+    return (riscv_clipped_rising_score_reduce || TARGET_XLISTREV
+	    || TARGET_XLISTFIND || TARGET_XMACACC || TARGET_XMBM
+	    || TARGET_XPADDH2 || TARGET_XDFA4H || TARGET_XDFA4P
+	    || TARGET_XDFASCAN);
+  }
+
+  static bool try_clipped_rising_score ()
+  {
+    tree args = DECL_ARGUMENTS (cfun->decl);
+    if (!args || !DECL_CHAIN (args) || !DECL_CHAIN (DECL_CHAIN (args))
+	|| DECL_CHAIN (DECL_CHAIN (DECL_CHAIN (args))))
+      return false;
+    tree n = args, base = DECL_CHAIN (n), clip = DECL_CHAIN (base);
+    if (TYPE_PRECISION (TREE_TYPE (n)) != 32
+	|| !POINTER_TYPE_P (TREE_TYPE (base))
+	|| TYPE_PRECISION (TREE_TYPE (TREE_TYPE (base))) != 32
+	|| TYPE_PRECISION (TREE_TYPE (clip)) != 16
+	|| TYPE_PRECISION (TREE_TYPE (TREE_TYPE (cfun->decl))) != 16
+	|| !clipped_rising_score_p (n, base, clip))
+      return false;
+    lower_clipped_rising_score (n, base, clip);
+    if (dump_file)
+      fprintf (dump_file, "recognized clipped rising-score reduction\n");
+    return true;
+  }
+
+  static bool try_list_reverse ()
+  {
+    tree param = DECL_ARGUMENTS (cfun->decl);
+    if (!list_reverse_p (param))
+      return false;
+    lower_list_reverse (param);
+    if (dump_file)
+      fprintf (dump_file, "recognized in-place list reversal\n");
+    return true;
+  }
+
+  static bool try_xdfa_scan ()
+  {
+    vec<gcall *> calls = vNULL;
+    tree tc = NULL_TREE, fc = NULL_TREE;
+    if (!find_xdfa_scan (calls, &tc, &fc, TARGET_XDFASCAN))
+      {
+	calls.release ();
+	return false;
+      }
+    enum xdfa_lowering lowering = (TARGET_XDFASCAN
+				   ? XDFA_WHOLE_SCAN
+				   : TARGET_XDFA4P ? XDFA_POINTER_STEPS
+						    : XDFA_STATE_STEPS);
+    lower_xdfa_scan (calls, tc, fc, lowering);
+    calls.release ();
+    /* The step loops and the counter-read epilogue extend the CFG; the
+       dominator tree no longer describes it.  update_ssa recomputes
+       dominance info when it is marked not computed.  */
+    free_dominance_info (CDI_DOMINATORS);
+    if (dump_file)
+      fprintf (dump_file, TARGET_XDFASCAN
+		       ? "recognized whole-string numeric-token DFA scan\n"
+		       : "recognized numeric-token DFA scan\n");
+    return true;
+  }
+
+  unsigned int execute (function *) final override
+  {
+    unsigned int todo = 0;
+    if (TARGET_XDFASCAN && xdfascan_transition_p ())
+      {
+	xdfascan_transition_decls.add (cfun->decl);
+	if (dump_file)
+	  fprintf (dump_file,
+		   "recognized numeric-token DFA transition semantics\n");
+      }
+    if (TARGET_XLISTFIND && list_find_p ())
+      {
+	lower_list_find ();
+	if (dump_file)
+	  fprintf (dump_file, "recognized linked-list search\n");
+	todo |= TODO_cleanup_cfg | TODO_update_ssa;
+      }
+    if (TARGET_XMACACC)
+      {
+	bool bit_extract = false;
+	if (matrix_accumulate_p (&bit_extract))
+	  {
+	    lower_matrix_accumulate (bit_extract);
+	    if (dump_file)
+	      fprintf (dump_file, bit_extract
+		       ? "recognized bit-extract matrix accumulation\n"
+		       : "recognized matrix multiply accumulation\n");
+	    todo |= TODO_cleanup_cfg | TODO_update_ssa;
+	  }
+      }
+    if (TARGET_XPADDH2 && packed_halfword_square_add_p ())
+      {
+	lower_packed_halfword_square_add ();
+	if (dump_file)
+	  fprintf (dump_file, "recognized packed halfword matrix scalar add\n");
+	todo |= TODO_cleanup_cfg | TODO_update_ssa;
+      }
+    if (TARGET_XMBM && lower_xmbm_expressions ())
+      todo |= TODO_update_ssa;
+    if (riscv_clipped_rising_score_reduce && try_clipped_rising_score ())
+      todo |= TODO_cleanup_cfg | TODO_update_ssa;
+    if (TARGET_XLISTREV && try_list_reverse ())
+      todo |= TODO_cleanup_cfg | TODO_update_ssa;
+    if ((TARGET_XDFA4H || TARGET_XDFA4P || TARGET_XDFASCAN)
+	&& try_xdfa_scan ())
+      todo |= TODO_cleanup_cfg | TODO_update_ssa;
+    return todo;
+  }
+};
+
+} // anonymous namespace
+
+gimple_opt_pass *
+make_pass_clipped_rising_score (gcc::context *ctxt)
+{
+  return new pass_clipped_rising_score (ctxt);
+}
