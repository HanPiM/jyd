+{
+  rtx n = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 0)));
+  rtx c = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 1)));
+  rtx a = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 2)));
+  rtx b = force_reg (SImode, expand_normal (gimple_call_arg (stmt, 3)));
+  rtx a_row = copy_to_mode_reg (SImode, a);
+  rtx b_col = copy_to_mode_reg (SImode, b);
+  rtx c_ptr = copy_to_mode_reg (SImode, c);
+  rtx outer = gen_label_rtx ();
+  rtx inner = gen_label_rtx ();
+  rtx accum = gen_label_rtx ();
+  rtx last = gen_label_rtx ();
+  rtx single = gen_label_rtx ();
+  rtx done = gen_label_rtx ();
+  rtx one = GEN_INT (1);
+
+  /* Configure the runtime dimension once, then collapse every inner product
+     to one memory-walking instruction.  Keep the generic expansion for zero
+     or dimensions that do not fit the walker's 16-bit counter.  */
+  if (TARGET_XDOTN)
+    {
+      rtx generic = gen_label_rtx ();
+      rtx dot_outer = gen_label_rtx ();
+      rtx dot_inner = gen_label_rtx ();
+      rtx dot_step = xmacacc_shift (n, 1);
+      rtx dot_elements = gen_reg_rtx (SImode);
+      emit_insn (gen_mulsi3 (dot_elements, n, n));
+      rtx dot_a_end = xmacacc_add (a, xmacacc_shift (dot_elements, 1));
+      rtx dot_b_end = xmacacc_add (b, dot_step);
+
+      emit_cmp_and_jump_insns (n, const0_rtx, EQ, NULL_RTX, SImode, 1,
+			       generic, profile_probability::very_unlikely ());
+      emit_cmp_and_jump_insns (n, GEN_INT (65535), GTU, NULL_RTX, SImode, 1,
+			       generic, profile_probability::very_unlikely ());
+      emit_label (dot_outer);
+      emit_move_insn (b_col, b);
+      /* Besides refreshing the state for each row, the configuration op
+	 separates the loop's b_col move from the blocking dot consumer.  */
+      emit_insn (gen_xdotn_configsi1 (n));
+      emit_label (dot_inner);
+      rtx dot_result = gen_reg_rtx (SImode);
+      emit_insn (bit_extract
+			 ? gen_xdotn_bitsi3 (dot_result, a_row, b_col)
+			 : gen_xdotnsi3 (dot_result, a_row, b_col));
+      emit_move_insn (gen_rtx_MEM (SImode, c_ptr), dot_result);
+      emit_insn (gen_addsi3 (c_ptr, c_ptr, GEN_INT (4)));
+      emit_insn (gen_addsi3 (b_col, b_col, GEN_INT (2)));
+      emit_cmp_and_jump_insns (b_col, dot_b_end, NE, NULL_RTX, SImode, 1,
+			       dot_inner, profile_probability::likely ());
+      emit_insn (gen_addsi3 (a_row, a_row, dot_step));
+      emit_cmp_and_jump_insns (a_row, dot_a_end, NE, NULL_RTX, SImode, 1,
+			       dot_outer, profile_probability::likely ());
+      emit_jump_insn (gen_jump (done));
+      emit_barrier ();
+      emit_label (generic);
+    }
+
+  emit_cmp_and_jump_insns (n, one, LEU, NULL_RTX, SImode, 1, single,
+			   profile_probability::very_unlikely ());
+  rtx b_step = xmacacc_shift (n, 1);
+  rtx elements = gen_reg_rtx (SImode);
+  emit_insn (gen_mulsi3 (elements, n, n));
+  rtx a_end = xmacacc_add (a, xmacacc_shift (elements, 1));
+  rtx b_end = xmacacc_add (b, b_step);
+
+  emit_label (outer);
+  emit_move_insn (b_col, b);
+  emit_label (inner);
+  rtx a_ptr = copy_to_mode_reg (SImode, a_row);
+  rtx b_ptr = copy_to_mode_reg (SImode, b_col);
+  rtx last_a = xmacacc_add (a_row, xmacacc_add (b_step, GEN_INT (-2)));
+
+  rtx av = xmacacc_load_half (a_ptr);
+  rtx bv = xmacacc_load_half (b_ptr);
+  rtx ignored = gen_reg_rtx (SImode);
+  emit_insn (bit_extract
+		     ? gen_xmacacc_bit_firstsi3 (ignored, av, bv)
+		     : gen_xmacacc_firstsi3 (ignored, av, bv));
+  emit_insn (gen_addsi3 (a_ptr, a_ptr, GEN_INT (2)));
+  emit_insn (gen_addsi3 (b_ptr, b_ptr, b_step));
+  emit_cmp_and_jump_insns (a_ptr, last_a, EQ, NULL_RTX, SImode, 1, last,
+			   profile_probability::even ());
+
+  emit_label (accum);
+  av = xmacacc_load_half (a_ptr);
+  bv = xmacacc_load_half (b_ptr);
+  ignored = gen_reg_rtx (SImode);
+  emit_insn (bit_extract
+		     ? gen_xmacacc_bit_addsi3 (ignored, av, bv)
+		     : gen_xmacacc_addsi3 (ignored, av, bv));
+  emit_insn (gen_addsi3 (a_ptr, a_ptr, GEN_INT (2)));
+  emit_insn (gen_addsi3 (b_ptr, b_ptr, b_step));
+  emit_cmp_and_jump_insns (a_ptr, last_a, NE, NULL_RTX, SImode, 1, accum,
+			   profile_probability::likely ());
+
+  emit_label (last);
+  av = xmacacc_load_half (a_ptr);
+  bv = xmacacc_load_half (b_ptr);
+  rtx result = gen_reg_rtx (SImode);
+  emit_insn (bit_extract
+		     ? gen_xmacacc_bit_lastsi3 (result, av, bv)
+		     : gen_xmacacc_lastsi3 (result, av, bv));
+  emit_move_insn (gen_rtx_MEM (SImode, c_ptr), result);
+  emit_insn (gen_addsi3 (c_ptr, c_ptr, GEN_INT (4)));
+  emit_insn (gen_addsi3 (b_col, b_col, GEN_INT (2)));
+  emit_cmp_and_jump_insns (b_col, b_end, NE, NULL_RTX, SImode, 1, inner,
+			   profile_probability::likely ());
+  emit_insn (gen_addsi3 (a_row, a_row, b_step));
+  emit_cmp_and_jump_insns (a_row, a_end, NE, NULL_RTX, SImode, 1, outer,
+			   profile_probability::likely ());
+  emit_jump_insn (gen_jump (done));
+  emit_barrier ();
+
+  emit_label (single);
+  emit_cmp_and_jump_insns (n, const0_rtx, EQ, NULL_RTX, SImode, 1, done,
+			   profile_probability::very_unlikely ());
+  av = xmacacc_load_half (a);
+  bv = xmacacc_load_half (b);
+  result = gen_reg_rtx (SImode);
+  emit_insn (gen_mulsi3 (result, av, bv));
+  if (bit_extract)
+    {
+      rtx lo = gen_reg_rtx (SImode);
+      rtx hi = gen_reg_rtx (SImode);
+      emit_insn (gen_lshrsi3 (lo, result, GEN_INT (2)));
+      emit_insn (gen_andsi3 (lo, lo, GEN_INT (15)));
+      emit_insn (gen_lshrsi3 (hi, result, GEN_INT (5)));
+      emit_insn (gen_andsi3 (hi, hi, GEN_INT (127)));
+      emit_insn (gen_mulsi3 (result, lo, hi));
+    }
+  emit_move_insn (gen_rtx_MEM (SImode, c), result);
+  emit_label (done);
+}
+
+static void
+expand_XMACACC_MATRIX (internal_fn, gcall *stmt)
+{
+  expand_xmacacc_matrix (stmt, false);
+}
+
+static void
+expand_XMACACC_BIT_MATRIX (internal_fn, gcall *stmt)
+{
+  expand_xmacacc_matrix (stmt, true);
+}
