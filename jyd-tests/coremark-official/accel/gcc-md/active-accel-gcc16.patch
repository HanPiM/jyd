+  emit_jump_insn (gen_jump (done_label));
+  emit_barrier ();
+  emit_label (data_label);
+  emit_move_insn (data16, gen_rtx_MEM (HImode, operands[2]));
+  emit_insn (gen_extendhisi2 (data, data16));
+  emit_insn (gen_xlistfind_datasi3 (operands[0], operands[1], data));
