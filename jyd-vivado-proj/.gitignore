# Vivado regenerates all per-IP output products from the checked-in XCI.
# Keep only the source configuration at this level; generated HDL, stubs,
# simulation models, OOC constraints, metadata, and documentation stay local.
digital_twin.srcs/sources_1/ip/*/*
!digital_twin.srcs/sources_1/ip/*/*.xci

# Local Codex/agent metadata
.agents/
.codex/

# Keep source project files, HDL, constraints, IP configs, and checked-in
# memory initialization files tracked.  The cur_coe directory above is the
# exception because the build script refreshes it at runtime.
