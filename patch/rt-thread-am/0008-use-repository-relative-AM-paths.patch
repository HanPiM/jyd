From 5397f8561c286f07446417fef58c11fbf3b22339 Mon Sep 17 00:00:00 2001
From: Wang Yi Jie <miwyj@mail.scut.edu.cn>
Date: Tue, 24 Mar 2026 13:42:50 +0800
Subject: [PATCH 8/9] use repository-relative AM paths

---
 bsp/abstract-machine/Makefile             | 2 +-
 bsp/abstract-machine/integrate-am-apps.py | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/bsp/abstract-machine/Makefile b/bsp/abstract-machine/Makefile
index 5511658..d9c4830 100644
--- a/bsp/abstract-machine/Makefile
+++ b/bsp/abstract-machine/Makefile
@@ -18,7 +18,7 @@ endif
 LDFLAGS += -T $(LINKSCRIPT)
 -include $(FILE_MK)
 -include $(AM_APPS_MK)
-include $(AM_HOME)/Makefile
+include $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../abstract-machine/Makefile)
 
 $(RTCONFIG_H):
 	touch $@
diff --git a/bsp/abstract-machine/integrate-am-apps.py b/bsp/abstract-machine/integrate-am-apps.py
index 8968df3..14cbb7b 100644
--- a/bsp/abstract-machine/integrate-am-apps.py
+++ b/bsp/abstract-machine/integrate-am-apps.py
@@ -4,8 +4,8 @@ import sys, os, shutil, subprocess
 from pathlib import Path
 
 # global settings
-AM_HOME = Path(os.environ["AM_HOME"])
-AM_KERNELS_HOME = (AM_HOME / ".." / "am-kernels").resolve()
+AM_HOME = Path(__file__).resolve().parents[3] / "abstract-machine"
+AM_KERNELS_HOME = AM_HOME.parent / "am-kernels"
 app_dir_list = [
   AM_KERNELS_HOME / "kernels" / "hello",
   AM_KERNELS_HOME / "benchmarks" / "microbench",
-- 
2.52.0

